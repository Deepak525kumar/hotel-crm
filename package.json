{
  "name": "hotel-crm-mvp",
  "version": "1.0.0",
  "description": "Hotel Management CRM - Modular Monolith Architecture",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "mobile/*"
  ],
  "scripts": {
    "dev": "cd backend && npm run dev",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "test": "cd backend && npm test",
    "type-check": "cd backend && npm run typecheck && cd ../frontend && npm run type-check"
  },
  "dependencies": {
    "expo": "~57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "overrides": {
    "@react-native/metro-config": "0.86.2",
    "@react-native/metro-babel-transformer": "0.86.2",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/babel-plugin-codegen": "0.86.2",
    "@react-native/codegen": "0.86.2",
    "@react-native/js-polyfills": "0.86.2"
  }
}

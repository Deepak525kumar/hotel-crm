# Security #4 (2026-08-09): the browser always calls the relative /api/v1
# path (lib/config.ts) -- Next.js's rewrites() proxy (next.config.ts) sends
# it to the backend server-side, in both dev and prod, so auth cookies stay
# same-origin. Point THIS at your backend instead if it's not on the
# default localhost:3001 (server-only, never sent to the browser):
BACKEND_INTERNAL_URL=http://localhost:3001

# Pivot cutover feature flag (marketplace | direct_dispatch)
NEXT_PUBLIC_PIVOT_MODE=marketplace

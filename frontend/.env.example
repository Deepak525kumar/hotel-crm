# Base URL of the backend API (includes the version prefix).
# The backend mounts all routes under /api/<API_VERSION> (default: v1)
# and listens on port 3001 by default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Pivot cutover feature flag (marketplace | direct_dispatch)
NEXT_PUBLIC_PIVOT_MODE=marketplace

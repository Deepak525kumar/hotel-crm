# Generated by CI on every run (.github/workflows/ci.yml writes it with --out and
# uploads it as a build artifact). A committed copy can only ever be stale.
integrity-report.md

# Real employee contracts / personal documents used as reference material while
# building the document-templates module. These contain real personal data
# (names, addresses, dates of birth, RV-Nummer) and must never be committed --
# only structural field NAMES derived from them ever enter the repository.
Arbeitsvertrag*.pdf

# Ignored Sensitive Files
Arbeitsvertrag_Alona_Likhoto_final.pdf
hotelcrm-key1.pem


# Agent skill packs: downloaded content, restored from skills-lock.json by the
# tooling that fetched them. Ignored so a local skill install does not show up
# as repository changes; the lock file is the only thing worth versioning, and
# committing it is a deliberate choice for whoever adds the skills, not a
# side effect of someone else's session.
.agents/skills/
skills-lock.json

# Firebase iOS config. NOT used by this system: the Platform Worker delivers
# to iOS over APNs directly (backend/src/modules/notifications/push-provider.ts),
# so no Firebase iOS SDK is present and expo.ios.googleServicesFile is unset.
# Ignored rather than committed so a stray download does not imply iOS push
# runs through Firebase. Android's google-services.json IS committed -- it is
# required in the build for FCM.
GoogleService-Info.plist

# Firebase Admin SDK service-account keys. REAL SECRETS: the private_key in
# one of these grants full backend access to the Firebase project (Firestore
# included, bypassing firestore.rules). They are downloaded to the repository
# root by the Firebase console's "Generate new private key" button, which is
# exactly where a `git add -A` would sweep one up. One appeared there during
# this work; verified never committed.
#
# The backend never reads a key FILE -- it reads the base64 of one from
# FIREBASE_SERVICE_ACCOUNT_KEY_BASE64 (see backend/.env.example), so there is
# no reason for one to be in the tree at all.
# Globs are deliberately broad: the console's filename format has changed
# before, and a key that slips through because it was named slightly
# differently is a rotation, not an inconvenience. The base64 forms count too
# -- the string in FIREBASE_SERVICE_ACCOUNT_KEY_BASE64 IS the private key, just
# re-encoded. *.p8 is the APNs signing key: same class of secret, arrives the
# same way, and is equally not needed in the tree.
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64*
*.p8

# Firebase Admin service-account keys, and anything derived from one.
#
# The Firebase console's "Generate new private key" button downloads
# <project>-firebase-adminsdk-<hash>.json straight into whatever directory the
# browser is pointed at -- frequently a repository root -- and a single
# `git add -A` would sweep it into a commit. The key grants full backend access
# to the Firebase project, including Firestore, bypassing firestore.rules
# entirely; a leak means rotating it, not deleting the commit.
#
# The backend never reads a key FILE: it reads the base64 of one from
# FIREBASE_SERVICE_ACCOUNT_KEY_BASE64. Nothing here ever needs to be tracked.
# The base64 patterns are covered too -- that string IS the private key, just
# re-encoded, and is no safer to commit than the JSON.
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64*
*.p8

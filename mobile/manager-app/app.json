{
  "expo": {
    "name": "Hotel CRM Manager",
    "slug": "manager-app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1f4e0ba5-58ed-4293-9b33-165911f58aab",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "managerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.fhmhotelservices.managerapp",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Zelle uses the microphone so you can speak a message to the assistant instead of typing it.",
        "NSSpeechRecognitionUsageDescription": "Zelle turns what you say into text so you can ask about your team without typing."
      }
    },
    "android": {
      "package": "com.fhmhotelservices.managerapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E8EAF5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3F4D8A",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-notifications",
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used when you attach a photo to a team member's record or a signed contract.",
          "cameraPermission": "Used when you photograph a document or a signed contract."
        }
      ],
      "expo-sharing",
      "./plugins/withDisableUserScriptSandboxing.js",
      "./plugins/with-metro-port",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f4e0ba5-58ed-4293-9b33-165911f58aab"
      }
    },
    "owner": "mayankk21"
  }
}

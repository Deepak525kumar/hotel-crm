# The dev-server port for this app. Committed on purpose, and one of THREE
# places this number lives: package.json's --port flags, this file, and
# plugins/with-metro-port.js (which writes ios/.xcode.env on prebuild).
# src/__tests__/dev-server-port.test.ts asserts all three agree.
#
# Without it, a manager build started from Xcode compiles the default 8081 in
# and attaches to whichever other app's Metro is running — serving worker-app's
# JavaScript inside the manager app's shell.
RCT_METRO_PORT=8083

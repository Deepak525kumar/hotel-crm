# Base URL for the Hotel CRM API (required).
#
# MUST include the /api/v1 suffix and point at the BACKEND port (3001) --
# NOT 3000, which is the Next.js web frontend. Getting this wrong fails every
# request with ERR_CONNECTION_REFUSED and shows only "Login failed".
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# On a PHYSICAL DEVICE or a non-simulator emulator, `localhost` is the phone
# itself, not your machine. Use your machine's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3001/api/v1
# (Android emulator can also use http://10.0.2.2:3001/api/v1)
#
# Staging/production URLs are NOT set here -- they come from eas.json's
# per-profile `env` block, which is what a release build reads.

# Pivot cutover feature flag (marketplace | direct_dispatch)
EXPO_PUBLIC_PIVOT_MODE=marketplace

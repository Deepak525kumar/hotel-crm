# Dev-server port for THIS app. worker-app keeps Expo's default 8081.
#
# Committed deliberately (.gitignore only excludes .env*.local, so your own
# .env.local still overrides everything here). Every Expo CLI entry point calls
# loadEnvFiles() before it resolves the port -- `expo start`, `expo run:ios`,
# `expo run:android` and `expo prebuild` alike -- so the port is correct even
# when you invoke the CLI directly instead of through `npm start`/`npm run ios`.
#
# Without it, both apps default to 8081: with worker-app's server already there,
# a checker build attaches to worker-app's Metro and runs the other app's
# JavaScript. See README's "Dev server port".
RCT_METRO_PORT=8082

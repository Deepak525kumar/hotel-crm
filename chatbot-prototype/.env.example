# Paste a real key to leave mock mode. Until then the service runs against a
# canned local responder so the conversation loop, budget guard, and tool
# registry can all be exercised without spending tokens or holding a secret.
ANTHROPIC_API_KEY=

# REQ-CHAT-003 / RULE-CHAT-01 — Claude Haiku is the confirmed default model.
CHATBOT_MODEL=claude-haiku-4-5-20251001

# REQ-CHAT-004 — hard monthly token budget cap (config-stored, per CRR §8 line 109).
CHATBOT_MONTHLY_TOKEN_CAP=2000000

# REQ-CHAT-005 — per-conversation token limit.
CHATBOT_PER_CONVERSATION_TOKEN_CAP=20000

PORT=4310

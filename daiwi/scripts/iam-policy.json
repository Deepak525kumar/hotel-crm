{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppBuildsObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::hotelcrm-uploads/app-builds/*"
    },
    {
      "Sid": "ListOnlyTheAppBuildsPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::hotelcrm-uploads",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["app-builds/*"]
        }
      }
    }
  ]
}

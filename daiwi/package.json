{
  "name": "hotel-crm-version-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Internal iOS/Android build distribution for the Hotel CRM: upload an .ipa/.apk, get a public install link and QR code.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "cp -R src/views src/public dist/",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "user:create": "tsx src/scripts/create-user.ts",
    "env:local": "./scripts/use-env.sh local",
    "env:production": "./scripts/use-env.sh production",
    "deploy": "./scripts/deploy.sh",
    "test": "tsx --test test/unit.test.ts",
    "test:e2e": "./test/e2e.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@prisma/client": "^5.20.0",
    "app-info-parser": "^1.1.6",
    "bcryptjs": "^2.4.3",
    "bplist-parser": "^0.3.2",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.6",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "plist": "^3.1.0",
    "qrcode": "^1.5.4",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.5",
    "@types/plist": "^3.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/yauzl": "^2.10.3",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}

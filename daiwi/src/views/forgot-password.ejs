<!doctype html>
<html lang="en">
<head><title>Reset your password</title><%- include("partials/head") %></head>
<body class="auth-page">
  <div class="auth-card">
    <h1>Reset your password</h1>
    <% if (sent) { %>
      <p class="notice">
        If an account exists for that address, a reset link is on its way. The link is valid
        for one hour and can be used once.
      </p>
      <p class="muted"><a href="<%= adminPath %>/login">Back to sign in</a></p>
    <% } else { %>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form method="post" action="<%= adminPath %>/forgot-password">
        <label>Email<input type="email" name="email" required autofocus autocomplete="username" /></label>
        <button type="submit">Send reset link</button>
      </form>
      <p class="muted"><a href="<%= adminPath %>/login">Back to sign in</a></p>
    <% } %>
  </div>
</body>
</html>

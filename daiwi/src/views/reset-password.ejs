<!doctype html>
<html lang="en">
<head><title>Choose a new password</title><%- include("partials/head") %></head>
<body class="auth-page">
  <div class="auth-card">
    <h1>Choose a new password</h1>
    <% if (expired) { %>
      <p class="error"><%= error %></p>
      <p class="muted">
        <a href="<%= adminPath %>/forgot-password">Request a new link</a>
      </p>
    <% } else { %>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form method="post" action="<%= adminPath %>/reset-password">
        <input type="hidden" name="token" value="<%= token %>" />
        <label>New password (<%= minLength %>+ characters)
          <input type="password" name="password" required minlength="<%= minLength %>" autofocus autocomplete="new-password" />
        </label>
        <label>Confirm new password
          <input type="password" name="confirmPassword" required minlength="<%= minLength %>" autocomplete="new-password" />
        </label>
        <button type="submit">Set new password</button>
      </form>
    <% } %>
  </div>
</body>
</html>

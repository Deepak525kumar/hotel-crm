# Copied to .env by scripts/use-env.sh. Do not put real secrets in this file —
# it is committed. .env itself is gitignored.

NODE_ENV=development
PORT=3002

# Mount paths. These must match the nginx location blocks.
ADMIN_PATH=/version-control
INSTALL_PATH=/install

# Absolute origin used to build every install link, QR code and iOS manifest URL.
# REQUIRED in production, and must be https — iOS silently refuses plain http
# and self-signed certificates for OTA installs.
PUBLIC_BASE_URL=

# Postgres. In production this points at the same server as the CRM API but at
# a dedicated role and schema (see scripts/provision-db.sql), so a compromise
# of this service cannot read CRM tables.
DATABASE_URL="postgresql://hotelcrm_vc:CHANGE_ME@localhost:5432/hotelcrm_dev?schema=version_control"

# Signing key for this service's own session cookie. MUST be different from the
# CRM's JWT_SECRET — sharing it would let either service mint the other's tokens.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Storage: 's3' in production, 'local' for a laptop with no AWS credentials.
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
S3_BUCKET=hotelcrm-uploads
S3_PREFIX=app-builds
AWS_REGION=eu-central-1

# Account issuing. Off in production: create operators with `npm run user:create`.
ALLOW_REGISTRATION=1
REGISTRATION_INVITE_CODE=

# 1 GiB
MAX_UPLOAD_BYTES=1073741824

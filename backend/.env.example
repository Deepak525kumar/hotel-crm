# Application
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database (AWS RDS PostgreSQL)
DATABASE_URL=postgresql://user:password@db-dev.xxxxxxxx.eu-central-1.rds.amazonaws.com:5432/hotel_crm?schema=public&sslmode=require

# Prisma connection pool. Unset, Prisma defaults to cpus*2+1 -- which is 5 on
# the 2-vCPU production host, and was measured as the hard ceiling on query
# concurrency there (RDS itself allows 181 connections). Applied in
# src/lib/db.ts, so leaving these unset is fine; override per environment.
DATABASE_POOL_SIZE=15
DATABASE_POOL_TIMEOUT_S=10

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# JWT (two separate secrets — access tokens use JWT_SECRET, refresh tokens use JWT_REFRESH_SECRET)
JWT_SECRET=your-access-token-secret-min-32-characters-here
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Logging
LOG_LEVEL=info

# Feature Flags
FEATURE_EMPLOYMENT_RECORD=true

# CORS & URLs
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# AWS S3 (File Storage)
# In deployed environments prefer the EC2 instance role over static keys.
AWS_REGION=eu-central-1
S3_BUCKET=hotelcrm-uploads
S3_BUCKET_BACKUPS=hotelcrm-backups
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY only when not using an instance role
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Email Service (Resend or SendGrid) — EMAIL_SERVICE must be lowercase,
# exactly "resend" or "sendgrid" (zod enum in config/env.ts); an unrecognized
# value fails validation and the app refuses to start.
EMAIL_SERVICE=resend
RESEND_API_KEY=your-resend-key
# EMAIL_FROM_ADDRESS must be on a domain verified in the provider's dashboard --
# an unverified sending domain fails every send with a 403 from Resend
# ("The X domain is not verified"), which the Platform Worker retries five
# times then dead-letters silently; nothing pages anyone. fhmhotelservice.de is
# the one domain currently verified in this project's Resend account.
EMAIL_FROM_ADDRESS=support@fhmhotelservice.de
# SENDGRID_API_KEY=your-sendgrid-key

# Apple Push Notifications (APNs)
# Encode key: base64 < AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
APNS_PRIVATE_KEY_BASE64=base64-encoded-content-of-your-p8-key-file
APNS_KEY_ID=your-key-id
APNS_TEAM_ID=your-team-id
# These are the APNs *topic* for each app and MUST equal that app's iOS
# bundle identifier exactly, as declared in mobile/<app>/app.json under
# `expo.ios.bundleIdentifier`. They are real values, not placeholders like
# the credentials above: a wrong topic is not a credential problem the
# operator will notice, it is a silent total outage.
#
# APNs answers a mismatched topic with 400 BadTopic, which is neither a
# 410 nor a BadDeviceToken, so push-provider.ts used to classify it as a
# transient failure -- every notification then rode the full backoff
# schedule into DEAD_LETTER while the boot log said "APNs configured".
# Both values below shipped as `com.hotelcrm.*` (copied from this file
# into the deployed .env and never updated), so 100% of iOS push for BOTH
# apps failed this way. src/__tests__/apns-topic-config.test.ts now pins
# them to app.json so the two can never silently disagree again.
APNS_BUNDLE_ID_WORKER=com.fhmhotelservices.workerapp
APNS_BUNDLE_ID_CHECKER=com.fhmhotelservices.checkerapp

# Firebase Cloud Messaging (FCM) — Android push delivery
# BOTH variables are required. FIREBASE_PROJECT_ID alone is not enough: FCM
# HTTP v1 (the only current, non-deprecated FCM API) authenticates with a
# short-lived OAuth2 token exchanged for a self-signed JWT, not a static
# server key. With the service-account key missing, no FCM client is
# constructed and every Android device is SKIPPED rather than delivered to —
# silently, since a skipped device is not a delivery failure.
# Encode key: base64 < service-account.json | tr -d '\n'
# These two enable FCM sends. Device push tokens themselves live in Postgres
# (the `PushToken` table) — see ADR-071.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=base64-encoded-content-of-your-service-account-json

# Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Pivot cutover feature flag (marketplace | direct_dispatch)
PIVOT_MODE=marketplace

# ---------------------------------------------------------------------------
# Chatbot (SPEC-CHATBOT-001, ADR-013/ADR-053) — SCAFFOLD, default OFF.
# While off, /api/v1/chatbot routes 404 (ADR-024 D3 "both-off = current
# behavior"). No LLM provider is wired yet: enabling this exposes only the
# tool-executor authorization boundary and one self-scoped read-only tool.
#
# Do NOT enable outside development until the three G2 blockers close:
# OD-CHAT-005 (scope beyond the owning worker), OD-CHAT-006 (prompt
# injection), OD-CHAT-013 (module owner unassigned).
# ---------------------------------------------------------------------------
FEATURE_CHATBOT=false

# REQ-CHAT-004 / REQ-CHAT-005 / OD-CHAT-010 cost + abuse bounds. Present now
# so the budget guard can be built and tested ahead of the provider wiring;
# nothing reads them until a provider exists.
CHATBOT_MONTHLY_TOKEN_CAP=2000000
CHATBOT_CONVERSATION_TOKEN_CAP=25000
CHATBOT_USER_DAILY_TOKEN_CAP=60000
CHATBOT_MAX_TOOL_CALLS_PER_TURN=5
CHATBOT_TURN_TIMEOUT_MS=20000

# Request-RATE limits, per authenticated user. Distinct from the token caps
# above: those bound what a user may SPEND, these bound how fast they may ask.
# Both have working defaults, so an existing deployment needs no change here.
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_TURN_RATE_LIMIT_MAX=20
CHATBOT_ACTION_RATE_LIMIT_MAX=40

# HMAC secret for high-risk-write confirmation tokens. Required only once a
# HIGH_RISK_WRITE tool is registered — none is yet (blocked on OD-CHAT-005).
# Must be 32+ characters when set.
# CHATBOT_CONFIRM_TOKEN_SECRET=

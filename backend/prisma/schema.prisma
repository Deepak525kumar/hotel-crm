// =============================================================================
// Hotel CRM — PRISMA_SCHEMA_V2  (PATCH_V1 applied)
// Architecture: Marketplace (hotels post requests, workers apply)
// Removed: Room, Task, TaskPhoto, DailyOperation
// Added: HotelWorker, WorkApplication, Attendance
// Patch: SP-1..SP-9 applied
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  WORKER
  CHECKER
  MANAGER
  ADMIN
  // ADR-030 D-5/M-1: additive-only (Postgres ALTER TYPE ADD VALUE). Gained no
  // MASTER capability; operational manager at hotel_group scope (D-5).
  // Promotion of existing group-associated managers happens via M-3, gated by
  // FEATURE_RM_ROLE — this enum value alone authorizes nothing (ADR-030 §6 PR-2, D-6).
  REGIONAL_MANAGER
}

// SP-1: INACTIVE removed; INVITED + REMOVED added to match frozen lifecycle.
// Lifecycle: INVITED → ACTIVE → SUSPENDED ↔ ACTIVE; ACTIVE/SUSPENDED → REMOVED (terminal)
enum HotelWorkerStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WorkRequestStatus {
  DRAFT
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
}

enum AssignmentStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
  REASSIGNED
}

// GD-18 narrow slice: SPEC-CALENDAR-001 REQ-CAL-T03/T08. Calendar-owned only —
// distinct from Job Dispatch's CalendarEntry/WorkerAssignment (ADR-021).
enum CalendarAbsenceKind {
  SICK
  VACATION
}

// SP-6: EXPECTED added as the initial pre-shift state; default changed to EXPECTED.
enum AttendanceStatus {
  EXPECTED // record created pre-shift; worker not yet checked in
  PRESENT
  ABSENT
  LATE
  PARTIAL
  EXCUSED
}

enum VerificationStatus {
  PASSED
  FAILED
  NEEDS_REWORK
}

// ADR-027 (2026-07-22, OQ-NOTIF-01): the canonical channel set is exactly these five
// members. Provider-specific integrations (WhatsApp, Slack, etc.) are a transport
// detail under one of these channels (e.g. WEBHOOK), never a new enum member.
enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
  WEBHOOK
}

// SP-8: Notification.type promoted from String to NotificationType enum.
// All values are domain events; free strings are not acceptable here.
enum NotificationType {
  // WorkRequest events
  WORK_REQUEST_PUBLISHED
  WORK_REQUEST_CANCELLED
  WORK_REQUEST_EXPIRING_SOON
  // WorkApplication events
  APPLICATION_RECEIVED // to manager: a worker applied
  APPLICATION_ACCEPTED // to worker: application approved
  APPLICATION_REJECTED // to worker: application declined
  APPLICATION_WITHDRAWN // to manager: worker withdrew
  // WorkerAssignment events
  ASSIGNMENT_CONFIRMED
  ASSIGNMENT_CANCELLED
  SHIFT_REMINDER // pre-shift reminder to worker
  SYSTEM // system-level notifications

  CHECK_IN_REMINDER // sent when shift start approaches with no check-in
  // Attendance events
  ATTENDANCE_VERIFIED // to worker: manager verified attendance
  WORKER_NO_SHOW // to manager: worker did not check in
  // Quality & Rating events
  QUALITY_VERIFICATION_SUBMITTED
  RATING_RECEIVED
  REWORK_REQUIRED // to worker: verification failed, rework needed
  // Calendar events (SPEC-CALENDAR-001, RULE-CAL-06)
  CALENDAR_ABSENCE_MARKED // to manager: worker marked sick/vacation
  // Calendar drag/reason feature (2026-08-08): the reverse direction --
  // fired when a manager/RM/admin marks or moves an absence on a worker's
  // behalf, so the worker learns about it rather than discovering it only
  // by checking the calendar.
  CALENDAR_ABSENCE_MARKED_FOR_WORKER // to worker: a manager marked/moved their sick/vacation entry
  // Job-dispatch broadcast events (Epic 9 PR 9.8, TREQ-003 delivery half)
  JOB_REQUEST_BROADCAST // to eligible worker: a skill-matched broadcast slot is open
  // Job-dispatch auto-close event (Epic 9 PR 9.10, TREQ-006)
  JOB_REQUEST_CLOSED // to the raising manager: an unfilled broadcast closed (6h auto-close or manual)
  // HR implementation PR 4 (SPEC-HR-001 EVT-HR-PayslipRequested/Fulfilled)
  HR_PAYSLIP_REQUESTED // to the requesting worker's Regional Manager: a new payslip request is outstanding
  HR_PAYSLIP_FULFILLED // to the requesting worker: their payslip request was marked emailed
  // HR implementation PR 5 (IF-HR-ContractExpiryReminder, ADR-041 escalation)
  HR_CONTRACT_EXPIRY_REMINDER // to the responsible manager: a contract nears its 1yr/2yr mark
  HR_PAYSLIP_REQUEST_ESCALATED // to the responsible manager's own manager (or Admin fallback): an unfulfilled payslip request has passed the 3-business-day window (ADR-041)
  HR_CONTRACT_LAPSED // to the requesting worker: their contract lapsed and offboarding was triggered (ADR-040/ADR-045)
  // Consent implementation (SPEC-CONSENT-001 REQ-CONSENT-003/RULE-CONSENT-03, ADR-015/ADR-037)
  CONSENT_DECLINED // to the worker's responsible manager: a worker declined the daily access-gate consent notice
  // SPEC-AUTH-001 TREQ-AUTH-007 / TRULE-AUTH-002 (2026-08-08): repeated failed
  // logins escalate by NOTIFYING, never by locking the account or throttling
  // further attempts (rate limiting is an edge concern, TREQ-AUTH-008).
  REPEATED_FAILED_LOGINS // to the account holder's responsible manager (admin fallback): N consecutive failed logins
  // Onboarding lifecycle (ADR-065, 2026-08-13). Until now employee-management
  // sent no notifications at all, so neither side of a review ever learned
  // anything happened: a reviewer had to poll the Review Queue, and an
  // applicant had to keep reopening My Onboarding to find out whether they
  // had been approved.
  ONBOARDING_SUBMITTED // to the reviewer (the creator's own superior): an application awaits review
  ONBOARDING_APPROVED // to the applicant: their application was approved
  ONBOARDING_REJECTED // to the applicant: their application was rejected
}

// ADR-029 (2026-07-23, GD-01): Transactional Outbox enums. OutboxEvent is the
// internal delivery/queue record — distinct from Notification (the user-facing
// inbox, unchanged by this ADR) and never exposed to any client. Domain-event
// naming is past-tense, matching future non-notification event types
// (e.g. CONTRACT_EXPIRED, WORK_REQUEST_CREATED) this enum is expected to grow to.
enum OutboxEventType {
  NOTIFICATION_CREATED
}

// What kind of domain aggregate this event is about. NOTIFICATION today; grows
// additively (ALTER TYPE ... ADD VALUE) as non-notification producers adopt the
// outbox as the future Event Bus producer (ADR-029 §11 / GD-12).
enum OutboxAggregateType {
  NOTIFICATION
}

// Which bounded-context module produced this event — a stable identity, unlike
// producer_service (a class name, kept as a plain String; see OutboxEvent.producer_service).
// Seeded with the four current notification producers (SPEC-NOTIF-001 ASM-NOTIF-01);
// grows additively as new producers are migrated (Epic 7 PR 7.3 migrates these four
// to notificationService.enqueue(); this enum value existing does not itself mean the
// producer has been migrated).
enum OutboxSourceModule {
  WORK_REQUESTS
  WORK_APPLICATIONS
  ATTENDANCE
  QUALITY
  CALENDAR
  DOCUMENTS
  HR
  CONSENT
  AUTH
  // Assignment lifecycle notifications (2026-08-05): cancel, move, reassign
  // — ASSIGNMENT_CONFIRMED/ASSIGNMENT_CANCELLED already existed in
  // NotificationType but were never enqueued anywhere; this is their module
  // tag, distinct from WORK_REQUESTS (which JOB_REQUEST_BROADCAST/
  // JOB_REQUEST_CLOSED file under, since those are JobRequest-lifecycle
  // events, not WorkerAssignment-lifecycle ones).
  ASSIGNMENTS
  // Onboarding lifecycle notifications (ADR-065, 2026-08-13): submitted /
  // approved / rejected. Distinct from WORK_APPLICATIONS, which tags
  // job-application events, not employment-onboarding ones.
  EMPLOYEE_MANAGEMENT
}

// Delivery lifecycle. PENDING -> PROCESSING is the Platform Worker's atomic claim
// (SELECT ... FOR UPDATE SKIP LOCKED, ADR-029 §7); PROCESSING -> DELIVERED on success;
// PROCESSING -> FAILED -> (retry) PENDING on a retryable failure; FAILED -> DEAD_LETTER
// once the configurable backoff schedule (default 1m/5m/15m/1h, ADR-029 §6) is exhausted.
// No transitions are performed by this PR — the Platform Worker (PR 7.2) owns them.
enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

// External dispatch transport. Deliberately excludes IN_APP — that is the
// Notification row's own channel (NotificationChannel), not an outbox transport;
// see ADR-029 §1. Only EMAIL/PUSH are implemented (PR 7.4/7.5); WEBHOOK/SMS are
// reserved (ADR-029 §4) and are valid enum values with no handler yet.
enum OutboxTransport {
  EMAIL
  PUSH
  WEBHOOK
  SMS
}

// Epic 7 PR 7.5 (ADR-029): which push provider a registered device token
// belongs to — APNs (iOS) or FCM (Android). Drives PushTransportHandler's
// per-token provider-client routing.
enum PushPlatform {
  IOS
  ANDROID
}

// Epic 7 PR 7.8: which mobile application a device token was registered from.
// APNs requires the `apns-topic` header to equal the *originating app's* bundle
// ID; a token minted by one app and sent with another's topic is rejected
// (DeviceTokenNotForTopic). The two apps have distinct bundle IDs
// (com.hotelcrm.workerapp / com.hotelcrm.checkerapp) and `manager`/`admin` may
// use BOTH, so one user can legitimately hold two IOS tokens needing different
// topics — `platform` alone cannot disambiguate them.
//
// Deliberately stores the *application*, not the bundle ID: the bundle ID is
// deployment configuration (APNS_BUNDLE_ID_WORKER / APNS_BUNDLE_ID_CHECKER), so
// changing one never requires a data migration, and a client can never
// influence an APNs header. FCM ignores this entirely — registration tokens are
// self-identifying, so Android has no equivalent constraint.
enum PushApp {
  WORKER
  CHECKER
}

// Epic 5 PR 5.6 (SPEC-EMP-001 REQ-EMP-002 / RULE-EMP-02, 03, 12): employee
// lifecycle status. No Suspended state; no rating/warning-driven automatic
// transition (invariant, MODULE_SPEC.md "State and Lifecycle").
// Permanent, non-terminal employment lifecycle (2026-08-06 rework,
// supersedes RULE-EMP-02/03/12's terminal-state design). Every state can
// return to ACTIVE — a person is never a dead end, so rehire never requires
// a duplicate User (RULE-EMP-01).
//
// PENDING collapses the old INACTIVE/UNDER_REVIEW distinction; that detail
// is preserved on EmploymentRecord.submitted_for_review_at instead (null =
// old INACTIVE, non-null = old UNDER_REVIEW), not as separate enum values.
//
// DEACTIVATED means a temporary pause only (leave/seasonal/suspension,
// EmploymentRecord.deactivation_reason required) — always reactivates
// directly to ACTIVE, no re-approval. DELETED means the person left the
// company (resigned/terminated/contract lapsed) and is the same action as
// User-level soft delete (deleted_at, is_active=false, token_generation
// bump) — its return is a true rehire: DELETED -> PENDING -> ACTIVE.
enum EmploymentStatus {
  PENDING
  ACTIVE
  DEACTIVATED
  REJECTED
  DELETED
}

// REQ-EMP-002 rework: reason a DEACTIVATED (temporary pause) transition was
// made. Distinct from a DELETED (left the company) transition, which has no
// enum here -- that path uses deleted_reason (free text) since "why someone
// left" doesn't reduce to a fixed small set the way a pause reason does.
enum DeactivationReason {
  TEMPORARY_LEAVE
  SEASONAL
  SUSPENDED
}

// Epic 5 PR 5.6 (SPEC-EMP-001 REQ-EMP-003 / RULE-EMP-04): fixed confirmed
// skill-tag set; no certifications, no expiring qualifications.
enum SkillTag {
  CLEANER
  PUBLIC_SERVICE
  KITCHEN_DISHWASHER
  WAITER
}

// =============================================================================
// AUTH MODULE
// =============================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password_hash      String
  first_name         String
  last_name          String
  phone              String?   @unique
  profile_photo_url  String?
  role               UserRole  @default(WORKER)
  // ADR-031 M-3 (PR-7): the stored permission snapshot is retired. Permissions
  // are derived request-time from ROLE_PERMISSIONS[role] (D-1); this column
  // ceased being read at PR-3, ceased being written at PR-4, and is dropped
  // here after a full-release soak (relocated to an operational rollout gate,
  // see docs/implementation/ADR-031_PRODUCTION_ROLLOUT_CHECKLIST.md). A
  // pre-drop snapshot is retained for one release per the migration's own
  // down.sql / backup-table note.
  is_active          Boolean   @default(true)
  email_verified_at  DateTime?
  phone_verified_at  DateTime?
  last_login_at      DateTime?
  // TREQ-AUTH-007 (2026-08-08): consecutive failed-login counter driving the
  // notify-the-manager escalation. NOT a lockout counter -- TRULE-AUTH-002's
  // confirmed pattern is "notify and never block", so nothing anywhere reads
  // this to deny a login; it only decides when to raise the alert. Reset to 0
  // on every successful login.
  failed_login_count Int       @default(0)
  // When the most recent consecutive-failure streak began. Recorded so the
  // notification can say "N attempts since <time>" rather than just a bare
  // count, and so a future retention sweep can age out stale streaks.
  failed_login_since DateTime?
  deleted_at         DateTime? // GDPR soft delete — keep row, null PII via separate job
  // ADR-031 M-1/D-3/D-4 (PR-2, enforced unconditionally as of PR-7): monotonic
  // revocation counter, mirrored into the access token's `token_generation`
  // claim at issuance. Incremented (never reset) by backend-auth on role
  // change / deactivation / soft delete / password reset; a mismatch against
  // the row invalidates an already-issued access token.
  token_generation   Int       @default(0)
  // 2026-08-13 fix: who created this account (POST /users). Nullable —
  // self-registered accounts (if any ever exist) and every pre-existing row
  // have no creator on record. Its sole purpose today is closing a real gap
  // in getUser()'s scope check (users/service.ts): a manager/RM who just
  // created a worker/checker account has no way to view that profile
  // afterward, because EmploymentRecord (the thing isWorkerInGroupScope
  // checks) doesn't exist yet -- it's created separately, later, via
  // POST /employees. Falling back to "the creator may always view their own
  // creation" closes that gap without reopening an IDOR: only the actual
  // creator gets the exception, not every manager who happens to share a
  // scope, and it stops mattering the moment a real EmploymentRecord (with
  // its own group-grain scope) exists.
  created_by_id      String?
  created_by         User?     @relation("user_created_by", fields: [created_by_id], references: [id], onDelete: SetNull)
  users_created      User[]    @relation("user_created_by")
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  // Relations
  sessions                                       Session[]
  hotel_workers                                  HotelWorker[]
  assignments                                    WorkerAssignment[]                 @relation("assigned_worker")
  assignments_managed                            WorkerAssignment[]                 @relation("assignment_manager")
  attendance_records                             Attendance[]                       @relation("attendee")
  attendance_verified                            Attendance[]                       @relation("attendance_verifier")
  verifications_performed                        QualityVerification[]              @relation("verifier")
  ratings_received                               Rating[]                           @relation("rated_worker")
  ratings_given                                  Rating[]                           @relation("rater")
  overall_rating                                 WorkerOverallRating?
  notifications                                  Notification[]
  push_tokens                                    PushToken[]
  created_work_requests                          JobRequest[]                       @relation("request_creator")
  audit_logs                                     AuditLog[]
  password_reset_tokens                          PasswordResetToken[]
  managed_hotel_groups                           HotelGroup[]                       @relation("regional_manager_of_group")
  managed_hotels                                 Hotel[]                            @relation("hotel_manager")
  calendar_absences                              CalendarAbsence[]                  @relation("calendar_absence_worker")
  calendar_absences_marked                       CalendarAbsence[]                  @relation("calendar_absence_marked_by")
  // SPEC-DOCUMENTS-001 (GD-16): documents owned by this worker and uploads
  // performed by this user on behalf of a worker (manager contract-scan, RULE-DOC-04).
  worker_documents                               WorkerDocument[]                   @relation("documents_worker")
  documents_uploaded                             WorkerDocument[]                   @relation("documents_uploader")
  // Epic 5 PR 5.6 (SPEC-EMP-001): the employment record's account link
  // (REQ-EMP-001, one record per account) and blocklist-entry authorship.
  employment_record                              EmploymentRecord?                  @relation("employment_record")
  employment_records_created                     EmploymentRecord[]                 @relation("employment_record_created_by")
  blocklist_entries_authored                     EmployeeBlocklistEntry[]           @relation("blocklist_author")
  // 2026-08-06 lifecycle rework: who performed each transition (null = system-driven, e.g. contract-lapse).
  employment_status_transitions                  EmploymentStatusHistory[]          @relation("employment_status_history_actor")
  // GD-14/OD-GEO-002 (SPEC-GEO-001): backend-geo owns worker-coordinate
  // capture + the 6-month retention sweep (Tier 1, CRR §25).
  geo_checkins                                   WorkerGeoCheckin[]                 @relation("geo_checkin_worker")
  // ADR-028: manager-entered "rooms completed" daily count, per worker's
  // full-day WorkerAssignment — no room-level task layer implied.
  rooms_completed_as_worker                      RoomsCompletedEntry[]              @relation("rooms_completed_worker")
  rooms_completed_entered                        RoomsCompletedEntry[]              @relation("rooms_completed_entered_by")
  // Epic 9 PR 9.5 (TREQ-001/MIG-GAP-03): manager calendar-placement direct
  // assignment — the worker placed and the manager who placed them.
  calendar_entries_as_worker                     CalendarEntry[]                    @relation("calendar_entry_worker")
  calendar_entries_placed                        CalendarEntry[]                    @relation("calendar_entry_placed_by")
  // SPEC-HR-001 (ADR-012/ADR-014): contract lifecycle + payslip-request
  // capability, owned exclusively by backend-hr.
  hr_contracts                                   Contract[]                         @relation("hr_contract_worker")
  hr_contracts_confirmed                         Contract[]                         @relation("hr_contract_confirmed_by")
  hr_payslip_requests                            PayslipRequest[]                   @relation("hr_payslip_worker")
  hr_payslip_requests_fulfilled                  PayslipRequest[]                   @relation("hr_payslip_fulfilled_by")
  // SPEC-CONSENT-001 (ADR-015): backend-consent owns consent lifecycle/
  // records/versions/withdrawal/renewal/audit history exclusively.
  consent_records                                ConsentRecord[]                    @relation("consent_worker")
  // Manager-vacancy history (both directions of "who was assigned" and "who
  // performed the assignment/vacancy action") for HotelGroup and Hotel.
  regional_manager_assignment_history            RegionalManagerAssignmentHistory[] @relation("regional_manager_assignment_history")
  regional_manager_assignment_history_assigned   RegionalManagerAssignmentHistory[] @relation("regional_manager_assignment_history_assigned_by")
  regional_manager_assignment_history_unassigned RegionalManagerAssignmentHistory[] @relation("regional_manager_assignment_history_unassigned_by")
  hotel_manager_assignment_history               HotelManagerAssignmentHistory[]    @relation("hotel_manager_assignment_history")
  hotel_manager_assignment_history_assigned      HotelManagerAssignmentHistory[]    @relation("hotel_manager_assignment_history_assigned_by")
  hotel_manager_assignment_history_unassigned    HotelManagerAssignmentHistory[]    @relation("hotel_manager_assignment_history_unassigned_by")
  // Document Templates module (2026-08-09): admin-authored reusable
  // templates, and a worker's filled/signed instances of them.

  created_shift_summaries DailyShiftSummary[] @relation("ShiftSummaryCreator")
  updated_shift_summaries DailyShiftSummary[] @relation("ShiftSummaryUpdater")

  @@index([role])
  @@index([is_active])
  @@index([deleted_at])
  @@index([created_by_id])
}

model Session {
  id            String   @id @default(cuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_token String   @unique
  device_info   String?
  ip_address    String?
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
}

// HOTFIX-AUTH-002: server-issued, single-use, expiring password-reset token.
// Only its hash is ever persisted; the raw token is the caller's proof of
// email ownership and is never stored.
model PasswordResetToken {
  id         String    @id @default(cuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  // ADR-031 D-5 (PR-6): a partial index on `used_at IS NOT NULL` also exists
  // (migration 20260727000000), supporting the sweep job's used-token
  // cleanup branch. Not expressible in the Prisma schema DSL (no `@@index`
  // WHERE clause) — same accepted drift as WorkerAssignment's partial
  // unique index (migration 20260613120000), which is likewise raw-SQL-only.

  @@index([user_id])
  @@index([expires_at])
}

// =============================================================================
// HOTEL MODULE
// =============================================================================

// Manager-vacancy tracking (Hotel.manager_user_id, HotelGroup.regional_manager_user_id):
// NULL alone is ambiguous (never assigned? demoted? resigned? temporarily
// closed?) — these fields make "no manager" an intentional, explained state
// rather than an unqualified absence, and the paired *AssignmentHistory model
// below keeps a full audit trail independent of the current pointer.
enum ManagerVacancyReason {
  NOT_ASSIGNED
  DEMOTED
  RESIGNED
  TERMINATED
  TRANSFERRED
  TEMPORARY
}

// HotelGroup: ADR-023 — first-class entity aggregating hotels under one Regional
// Manager with shared billing. Owned by backend-crm. The FK lives on
// HotelGroup, not User, because ADR-023 §1 originally left open whether one
// Regional Manager could manage several groups; Regional Manager V1 Decision
// 1 (2026-08-05, PR #339) closed that question the other way -- exactly one
// group per Regional Manager -- and added @unique below to enforce it.
//
// regional_manager_user_id is nullable (relaxed from the original non-null
// @unique — a group may now go temporarily vacant, e.g. on demotion, rather
// than being unable to demote its RM at all until a replacement exists).
// @unique is preserved: Postgres permits multiple NULL rows under a unique
// index, so vacancy for several groups at once is unaffected, while a
// non-null value is still guaranteed to name at most one group.
model HotelGroup {
  id                              String                @id @default(cuid())
  name                            String
  billing_info                    String?
  regional_manager_user_id        String?               @unique
  regional_manager                User?                 @relation("regional_manager_of_group", fields: [regional_manager_user_id], references: [id], onDelete: SetNull)
  regional_manager_assigned_at    DateTime?
  regional_manager_vacated_at     DateTime?
  regional_manager_vacancy_reason ManagerVacancyReason?
  // Entity lifecycle (2026-08-07). HotelGroup previously supported ONLY hard
  // delete (prisma.hotelGroup.delete), while Hotel had is_active + deleted_at.
  // The two entities now share one model: ACTIVE -> DEACTIVATED (temporary,
  // reversible) and -> DELETED (permanent removal from operations, history
  // preserved, restorable by an admin). True row removal, if ever needed, is
  // a separate PURGE operation -- deliberately not overloaded onto delete.
  is_active                       Boolean               @default(true)
  deleted_at                      DateTime?
  created_at                      DateTime              @default(now())
  updated_at                      DateTime              @updatedAt

  // Relations
  hotels                              Hotel[]
  // Epic 5 PR 5.6 (ADR-023 §4): employment records associated with this group.
  employment_records                  EmploymentRecord[]                 @relation("employment_group")
  employment_records_target           EmploymentRecord[]                 @relation("target_employment_group")
  regional_manager_assignment_history RegionalManagerAssignmentHistory[]

  @@index([regional_manager_user_id])
  // Operational lists filter on these, so index them the way Hotel does.
  @@index([is_active])
  @@index([deleted_at])
}

// Full audit trail of RM assignments/vacancies for a HotelGroup, independent
// of the current regional_manager_user_id pointer (which only ever reflects
// the latest state). assigned_by/unassigned_by are nullable — a row created
// by a migration backfill or system process has no human actor.
model RegionalManagerAssignmentHistory {
  id                       String                @id @default(cuid())
  hotel_group_id           String
  hotel_group              HotelGroup            @relation(fields: [hotel_group_id], references: [id], onDelete: Cascade)
  regional_manager_user_id String
  regional_manager         User                  @relation("regional_manager_assignment_history", fields: [regional_manager_user_id], references: [id], onDelete: Restrict)
  assigned_at              DateTime
  unassigned_at            DateTime?
  assigned_by_id           String?
  assigned_by              User?                 @relation("regional_manager_assignment_history_assigned_by", fields: [assigned_by_id], references: [id], onDelete: SetNull)
  unassigned_by_id         String?
  unassigned_by            User?                 @relation("regional_manager_assignment_history_unassigned_by", fields: [unassigned_by_id], references: [id], onDelete: SetNull)
  reason                   ManagerVacancyReason?

  @@index([hotel_group_id])
  @@index([regional_manager_user_id])
}

model Hotel {
  id             String    @id @default(cuid())
  name           String
  city           String
  country        String    @default("Germany")
  address        String
  timezone       String    @default("Europe/Berlin")
  contact_email  String?
  contact_phone  String?
  is_active      Boolean   @default(true)
  // GD-05: per-hotel "pause new jobs" toggle (REQ-CRM-008). Enforced at
  // work-request creation, not a role/scope gate — checked in addition to
  // is_active/deleted_at, not instead of them.
  accepting_jobs Boolean   @default(true)
  // GD-14/OD-GEO-001 (SPEC-GEO-001): the hotel-coordinate source of truth,
  // kept as columns on Hotel (state-hotel, backend-crm-owned), not a
  // separate backend-geo-owned domain. Nullable: most hotels have none set
  // yet; backend-geo's distance-check fails closed (OD-GEO-003) when either
  // is null. Admin-only manual entry (OD-GEO-004) — no geocoding service.
  latitude       Float?
  longitude      Float?
  deleted_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // ADR-023: nullable until assigned ("after a hotel is created, it is assigned" — CRR §11).
  // ADR-025: nullable — dedicated Hotel Manager assigned after hotel creation (CRR §11).
  // Both additive only in this migration — no reader consumes either field yet (Epic 5 PR 5.1).
  hotel_group_id         String?
  hotel_group            HotelGroup?           @relation(fields: [hotel_group_id], references: [id], onDelete: SetNull)
  manager_user_id        String?
  manager                User?                 @relation("hotel_manager", fields: [manager_user_id], references: [id], onDelete: SetNull)
  manager_assigned_at    DateTime?
  manager_vacated_at     DateTime?
  manager_vacancy_reason ManagerVacancyReason?

  // Relations
  hotel_workers              HotelWorker[]
  work_requests              JobRequest[]
  assignments                WorkerAssignment[]
  attendance                 Attendance[]
  verifications              QualityVerification[]
  ratings                    Rating[]
  notifications              Notification[]
  // Epic 5 PR 5.6 (SPEC-EMP-001 REQ-EMP-005 / RULE-EMP-07): hotel blocklist entries.
  blocklist_entries          EmployeeBlocklistEntry[]        @relation("hotel_blocklist")
  // ADR-028: manager-entered "rooms completed" daily counts for this hotel.
  rooms_completed_entries    RoomsCompletedEntry[]
  // GD-14/OD-GEO-002 (SPEC-GEO-001): worker geofence checks against this
  // hotel's coordinates (backend-geo-owned, read-only from CRM's side).
  geo_checkins               WorkerGeoCheckin[]
  // Epic 9 PR 9.5 (TREQ-001/MIG-GAP-03): manager calendar-placement direct
  // assignments at this hotel.
  calendar_entries           CalendarEntry[]
  manager_assignment_history HotelManagerAssignmentHistory[]
  // Person-centric assignment redesign (2026-08-07): display/default-selection
  // only -- see EmploymentRecord.primary_hotel_id.
  employment_records_primary EmploymentRecord[]              @relation("employment_primary_hotel")
  employment_records_target  EmploymentRecord[]              @relation("target_employment_primary_hotel")
  shift_summaries            DailyShiftSummary[]

  @@index([country])
  @@index([is_active])
  @@index([city, country])
  @@index([hotel_group_id])
  @@index([manager_user_id])
}

// Full audit trail of Hotel Manager assignments/vacancies, independent of
// the current manager_user_id pointer -- mirrors
// RegionalManagerAssignmentHistory for the Hotel/manager relationship.
model HotelManagerAssignmentHistory {
  id               String                @id @default(cuid())
  hotel_id         String
  hotel            Hotel                 @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  manager_user_id  String
  manager          User                  @relation("hotel_manager_assignment_history", fields: [manager_user_id], references: [id], onDelete: Restrict)
  assigned_at      DateTime
  unassigned_at    DateTime?
  assigned_by_id   String?
  assigned_by      User?                 @relation("hotel_manager_assignment_history_assigned_by", fields: [assigned_by_id], references: [id], onDelete: SetNull)
  unassigned_by_id String?
  unassigned_by    User?                 @relation("hotel_manager_assignment_history_unassigned_by", fields: [unassigned_by_id], references: [id], onDelete: SetNull)
  reason           ManagerVacancyReason?

  @@index([hotel_id])
  @@index([manager_user_id])
}

// HotelWorker: roster — which workers are affiliated with a hotel and at what rate.
// A worker must be ACTIVE on the hotel's roster to be eligible for its WorkRequests.
// SP-2: invited_at records invite issuance; joined_at nullable until INVITED→ACTIVE.
model HotelWorker {
  id          String            @id @default(cuid())
  hotel_id    String
  hotel       Hotel             @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  worker_id   String
  worker      User              @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  position    String // "cleaner" | "checker" | "housekeeper" | "supervisor"
  status      HotelWorkerStatus @default(INVITED) // SP-1/SP-2: starts INVITED, not ACTIVE
  hourly_rate Decimal?          @db.Decimal(10, 2)
  currency    String            @default("EUR")
  notes       String?
  invited_at  DateTime          @default(now()) // SP-2: set at row creation
  joined_at   DateTime? // SP-2: set on INVITED → ACTIVE transition only
  left_at     DateTime? // set on → REMOVED transition
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  // A worker appears on a hotel's roster exactly once
  @@unique([hotel_id, worker_id])
  @@index([hotel_id])
  @@index([worker_id])
  @@index([status])
  @@index([position])
}

// =============================================================================
// EMPLOYEE MANAGEMENT MODULE (Epic 5 PR 5.6, SPEC-EMP-001 v0.2.0)
// =============================================================================

// EmploymentRecord: the single authoritative per-employee record (REQ-EMP-001).
// ADR-023 §4: carries hotel_group_id (group-grain FK to backend-crm's
// HotelGroup), nullable until hire-approval, set at Under Review -> Active.
// ADR-025 Decision 3: deliberately hotel-tie-free — no per-hotel FK here.
model EmploymentRecord {
  id          String           @id @default(cuid())
  user_id     String           @unique // account link (REQ-EMP-001: one record per account)
  user        User             @relation("employment_record", fields: [user_id], references: [id], onDelete: Cascade)
  employee_id String           @unique // human-facing Employee ID
  job_title   String // free text, provisional (OD-EMP-13)
  start_date  DateTime
  status      EmploymentStatus @default(PENDING)
  version     Int              @default(0) // ADR-036: optimistic concurrency

  // Sub-state of PENDING only (2026-08-06 rework): null = old INACTIVE
  // (onboarding not yet submitted), non-null = old UNDER_REVIEW (awaiting
  // approval). Status itself stays PENDING across both; only Approve/Reject
  // actually changes status.
  submitted_for_review_at DateTime?
  // Required when status transitions to DEACTIVATED (temporary pause);
  // null otherwise.
  deactivation_reason     DeactivationReason?
  // Free-text reason captured when status transitions to DELETED (left the
  // company) -- unlike deactivation_reason, not a fixed enum (RULE-EMP-02
  // rework rationale above the DeactivationReason enum).
  deleted_reason          String?
  // Increments only on DELETED -> PENDING (a rehire after leaving), never on
  // DEACTIVATED -> ACTIVE (same cycle continuing) or REJECTED -> ACTIVE.
  // Denormalized on top of EmploymentStatusHistory for cheap "how many times
  // rehired" / "current cycle" reads; EmploymentStatusHistory stays the
  // source of truth for cycle boundaries.
  employment_cycle        Int                 @default(1)
  marked_suitable         Boolean             @default(false) // probation milestone flag, not a status
  hotel_group_id          String? // ADR-023 §4, group-grain, nullable until hire-approval
  hotel_group             HotelGroup?         @relation("employment_group", fields: [hotel_group_id], references: [id], onDelete: SetNull)
  // Person-centric assignment redesign (2026-08-07): DISPLAY/DEFAULT-SELECTION
  // ONLY -- deliberately NOT an eligibility restriction. A worker's actual
  // eligibility to work a hotel remains governed exclusively by
  // hotel_group_id above via roster-scope.ts (REQ-EMP-012: a worker may work
  // ANY hotel in their assigned group). This field must never be read by
  // roster-scope.ts or any eligibility check -- it exists solely so the UI
  // has a sensible default hotel to preselect for a worker/checker.
  primary_hotel_id        String?
  primary_hotel           Hotel?              @relation("employment_primary_hotel", fields: [primary_hotel_id], references: [id], onDelete: SetNull)
  // ADR-065 §6 item 8: Replaces the nationality-derived WORK_PERMIT requirement.
  // Explicitly set by the creating actor at application-creation time (defaults false), 
  // determining whether the WORK_PERMIT document category is strictly required.
  work_permit_required    Boolean             @default(false)
  // ADR-065 §6 item 3, 5: Pre-activation routing/default-target fields.
  // Never read by eligibility or authorization logic, but remain live/editable
  // post-activation too (Decision 5).
  target_hotel_group_id   String?
  target_hotel_group      HotelGroup?         @relation("target_employment_group", fields: [target_hotel_group_id], references: [id], onDelete: SetNull)
  target_primary_hotel_id String?
  target_primary_hotel    Hotel?              @relation("target_employment_primary_hotel", fields: [target_primary_hotel_id], references: [id], onDelete: SetNull)
  skills                  SkillTag[] // fixed set (REQ-EMP-003)
  personal_data           Json? // Personalfragebogen non-special data (REQ-EMP-011)
  konfession              String? // special-category (RULE-EMP-09) — never on general profile
  disability_status       String? // special-category (RULE-EMP-09)
  // Mandatory at application-creation time (2026-08-13 contract feature):
  // the creating actor (the applicant's direct superior in the hierarchy,
  // lib/role-hierarchy.ts) declares whether the applicant is being onboarded
  // full-time or part-time. Drives which default contract PDF marking is
  // expected — Contract itself carries its own copy (employment_type on
  // Contract below) rather than joining back here, so a later change to
  // this field cannot silently retroact an already-generated contract.
  employment_type         EmploymentType
  // Creator of this application (2026-08-13 review-routing fix): the review
  // queue routes to this user's own manager/RM/admin, i.e. one level above
  // the actor who created the application -- NOT to the applicant's target
  // hotel/group scope as before. Nullable only for rows that predate this
  // column (backfilled null by migration); getReviewQueue() falls back to
  // admin-wide visibility for those legacy rows.
  created_by_id           String?
  created_by              User?               @relation("employment_record_created_by", fields: [created_by_id], references: [id], onDelete: SetNull)
  deleted_at              DateTime? // soft delete (REQ-EMP-010) -- mirrors User.deleted_at (Decision 1: DELETED == deleteUser())
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  blocklist_entries EmployeeBlocklistEntry[]  @relation("blocklist_of_employee")
  status_history    EmploymentStatusHistory[] @relation("employment_status_history")

  @@index([hotel_group_id])
  @@index([target_hotel_group_id])
  @@index([status])
  @@index([primary_hotel_id])
  @@index([created_by_id])
}

// 2026-08-13: full-time / part-time marking, mandatory at application
// creation. Determines which pre-printed marking the applicant is expected
// to select on the downloaded default contract PDF (manual review by the
// approving manager, not machine-checked -- see hr/service.ts createContract()).
enum EmploymentType {
  FULL_TIME
  PART_TIME
}

// Append-only lifecycle transition log (2026-08-06 rework). Every
// EmploymentStatus write MUST insert exactly one row here in the same
// transaction (enforced by employee-management/service.ts's single
// applyTransition() helper -- no other code path may write
// EmploymentRecord.status/employment_cycle directly). This is the source of
// truth for employment-cycle boundaries: cycle N spans from the DELETED ->
// PENDING row bearing employment_cycle = N to the next such row, or to now.
// Because this table is append-only and each row's created_at is immutable,
// historical WorkerAssignment/Attendance/etc. rows can be attributed to a
// cycle by joining worker_id -> User -> EmploymentRecord and bucketing the
// row's own timestamp against these intervals, without ever risking a
// record "migrating" to a later cycle after a rehire.
model EmploymentStatusHistory {
  id                   String           @id @default(cuid())
  employment_record_id String
  employment_record    EmploymentRecord @relation("employment_status_history", fields: [employment_record_id], references: [id], onDelete: Cascade)
  from_status          EmploymentStatus
  to_status            EmploymentStatus
  reason               String? // required for DEACTIVATED/DELETED transitions at the service layer; not DB-enforced
  actor_user_id        String? // null for system-driven transitions (e.g. contract-lapse)
  actor                User?            @relation("employment_status_history_actor", fields: [actor_user_id], references: [id], onDelete: SetNull)
  employment_cycle     Int // the cycle this transition occurred within
  created_at           DateTime         @default(now())

  @@index([employment_record_id])
  @@index([created_at])
}

// EmployeeBlocklistEntry: hotel-scoped block preventing a specific employee
// from assignment at that hotel, with a mandatory logged reason (REQ-EMP-005 /
// RULE-EMP-07).
model EmployeeBlocklistEntry {
  id                   String           @id @default(cuid())
  hotel_id             String
  hotel                Hotel            @relation("hotel_blocklist", fields: [hotel_id], references: [id], onDelete: Cascade)
  employment_record_id String
  employment_record    EmploymentRecord @relation("blocklist_of_employee", fields: [employment_record_id], references: [id], onDelete: Cascade)
  reason               String // REQUIRED (RULE-EMP-07)
  created_by_id        String
  created_by           User             @relation("blocklist_author", fields: [created_by_id], references: [id], onDelete: Restrict)
  created_at           DateTime         @default(now())

  @@unique([hotel_id, employment_record_id])
  @@index([hotel_id])
  @@index([employment_record_id])
}

// =============================================================================
// MARKETPLACE MODULE
// =============================================================================

// SP-9: version column added for optimistic locking against slot-fill race conditions.
// Epic 9 PR 9.4: model renamed WorkRequest -> JobRequest ("re-label schema off
// marketplace" framing, TREQ-013/MIG-GAP-12). @@map("WorkRequest") preserves the
// physical table name so this is a Prisma-level rename only, not a data migration
// (see IMPLEMENTATION_EXECUTION_PLAN.md PR 9.4's repository-reality correction).
model JobRequest {
  id                  String            @id @default(cuid())
  hotel_id            String
  hotel               Hotel             @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  created_by_id       String
  created_by          User              @relation("request_creator", fields: [created_by_id], references: [id], onDelete: Restrict)
  position            String // required role for this shift
  workers_needed      Int               @default(1)
  workers_confirmed   Int               @default(0)
  version             Int               @default(0) // SP-9: incremented on each status-changing write
  shift_date          DateTime          @db.Date
  shift_start_time    String // stored as HH:MM; derive full DateTime with hotel timezone
  shift_end_time      String
  hourly_rate         Decimal?          @db.Decimal(10, 2)
  currency            String            @default("EUR")
  description         String?
  requirements        String? // free-text skill/cert requirements
  status              WorkRequestStatus @default(DRAFT)
  published_at        DateTime?
  expires_at          DateTime?
  filled_at           DateTime?
  cancelled_at        DateTime?
  cancellation_reason String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  // Relations
  assignments             WorkerAssignment[]
  // Epic 9 PR 9.3: back-relation for WorkerAssignment.job_request_id (forward-
  // named ahead of PR 9.4's WorkRequest -> JobRequest rename, now completed).
  // Nullable FK; no creation path populates it until PR 9.9 (broadcast-accept).
  job_request_assignments WorkerAssignment[]    @relation("job_request_assignment")
  // Epic 9 PR 9.7 (TREQ-002/TREQ-010, MIG-GAP-04/05): per-skill headcount
  // lines for a broadcast raised via raiseBroadcast(). `position`/
  // `workers_needed`/`workers_confirmed` above are left untouched — they
  // remain the live fields for the pre-existing marketplace publish/apply
  // flow (job-requests/service.ts create()/update(), still reachable until
  // TREQ-011's removal, out of this PR's scope) and for
  // analytics/service.ts's existing aggregate. A broadcast JobRequest (raised
  // by raiseBroadcast(), not create()) carries its skill×headcount breakdown
  // here instead, per CONFIRMED_REQUIREMENTS_REGISTER.md §13's "2 Cleaners +
  // 1 Waiter" example (one broadcast, multiple skill lines) — see
  // architecture review before this PR's implementation.
  skill_slots             JobRequestSkillSlot[]

  // workers_confirmed must never exceed workers_needed — CHECK constraint in migration.
  // Slot-fill race: app layer must do UPDATE ... WHERE version = $known AND workers_confirmed < workers_needed.
  @@index([hotel_id])
  @@index([created_by_id])
  @@index([status])
  @@index([shift_date])
  @@index([position])
  @@index([hotel_id, status, shift_date]) // hot path: "open shifts at hotel on date"
  @@map("WorkRequest")
}

// Epic 9 PR 9.7 (TREQ-002/TREQ-003/TREQ-010, MIG-GAP-04/05): one row per
// skill×headcount line on a broadcast JobRequest (raiseBroadcast()), e.g.
// "2 Cleaners + 1 Waiter" is two rows on the same job_request_id. Purely
// additive — no legacy JobRequest row is backfilled into this table, since
// broadcast is new capability, not a repurposed existing field.
//
// `confirmed_count` is included now (default 0, unused by this PR's own
// eligibility-only logic) so PR 9.9's first-accept arbitration has a
// per-skill optimistic-concurrency target to claim against
// (`UPDATE ... WHERE id = $slotId AND confirmed_count < headcount`, the same
// conditional-updateMany shape ADR-057 names as the reused precedent) without
// needing its own schema-only PR before that logic lands.
model JobRequestSkillSlot {
  id              String     @id @default(cuid())
  job_request_id  String
  job_request     JobRequest @relation(fields: [job_request_id], references: [id], onDelete: Cascade)
  skill           SkillTag
  headcount       Int
  confirmed_count Int        @default(0)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  // Back-reference for WorkerAssignment.skill_slot_id (2026-08-05 lifecycle fix).
  claimed_by WorkerAssignment[]

  // confirmed_count must never exceed headcount — CHECK constraint in migration.
  @@index([job_request_id])
  @@index([skill])
}

// SP-5: @@unique([work_request_id, worker_id]) removed.
//       A worker can have multiple assignment rows for the same request
//       (CANCELLED + new CONFIRMED via reassignment chain). Double-booking for
//       active statuses is prevented by the partial unique index in the migration.
// Epic 9 PR 9.2: application_id (mandatory FK to the now-removed
// WorkApplication) dropped. WorkApplication and ApplicationStatus are
// deleted in this same PR (TREQ-011: no apply endpoint, no WorkApplication
// table). This leaves WorkerAssignment with no create path — the only
// creator was work-applications/service.ts's approve(), deleted alongside
// it. A replacement creation path is out of this PR's scope; PR 9.3 repoints
// this model to a nullable job_request_id, with fresh creation paths landing
// in PR 9.5 (calendar) and PR 9.9 (broadcast accept).
// Epic 9 PR 9.3: job_request_id added (nullable — no creation path writes
// it yet; PR 9.9's broadcast-accept path is the first writer). PR 9.4
// completed the WorkRequest -> JobRequest model rename; job_request_id's
// relation target is the JobRequest model. onDelete: SetNull matches this
// schema's convention for optional FKs (see Hotel.hotel_group,
// User.hotel_group, AuditLog.actor) — an assignment should outlive the job
// request it was created from, not be deleted alongside it.
model WorkerAssignment {
  id                     String               @id @default(cuid())
  // Epic 9 PR 9.5 (TREQ-001/MIG-GAP-03): relaxed from mandatory to nullable.
  // A calendar-placed assignment (placeOnCalendar()) has no backing JobRequest
  // at all (per ADR-056's ratified "no intermediating application or
  // acceptance record required" language) and so cannot populate this column
  // — mirrors PR 9.3's own migration-sequencing reasoning ("avoid a transient
  // assignment-creation-invariant state"), applied here to work_request_id's
  // parallel disposition rather than only to application_id/job_request_id.
  // Every pre-existing row keeps its current non-null value; only the
  // NOT NULL constraint relaxes (additive, reversible, zero data-loss).
  work_request_id        String?
  work_request           JobRequest?          @relation(fields: [work_request_id], references: [id], onDelete: Cascade)
  job_request_id         String?
  job_request            JobRequest?          @relation("job_request_assignment", fields: [job_request_id], references: [id], onDelete: SetNull)
  // Job-dispatch lifecycle audit fix (2026-08-05): records exactly which
  // skill slot a broadcast-accept assignment claimed. A multi-skill
  // broadcast (e.g. "2 Cleaners + 1 Waiter") has several
  // JobRequestSkillSlot rows on the same job_request_id, and a worker
  // holding more than one of the requested skills makes worker_id +
  // job_request_id alone ambiguous as to which slot's confirmed_count to
  // decrement on cancellation. Null for every creation path except
  // acceptBroadcast() (calendar-placed and pre-existing rows have no slot to
  // reference) -- additive, no backfill possible or needed for historical
  // rows since the information was never recorded.
  skill_slot_id          String?
  skill_slot             JobRequestSkillSlot? @relation(fields: [skill_slot_id], references: [id], onDelete: SetNull)
  worker_id              String
  worker                 User                 @relation("assigned_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  hotel_id               String
  hotel                  Hotel                @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  assigned_by_id         String
  assigned_by            User                 @relation("assignment_manager", fields: [assigned_by_id], references: [id], onDelete: Restrict)
  status                 AssignmentStatus     @default(CONFIRMED)
  confirmed_at           DateTime             @default(now())
  started_at             DateTime?
  completed_at           DateTime?
  cancelled_at           DateTime?
  cancellation_reason    String?
  // Self-referential chain for reassignments
  previous_assignment_id String?
  previous_assignment    WorkerAssignment?    @relation("reassignment_chain", fields: [previous_assignment_id], references: [id], onDelete: SetNull)
  reassignments          WorkerAssignment[]   @relation("reassignment_chain")
  updated_at             DateTime             @updatedAt

  // Epic 9 PR 9.6 (TREQ-007/TRULE-006, MIG-GAP-08): denormalized calendar
  // day for this assignment, populated identically regardless of creation
  // path (work_request_id-lineage rows backfilled from JobRequest.shift_date;
  // calendar-placed rows backfilled from the sibling CalendarEntry.day;
  // going forward, every creation path writes this directly at create time --
  // see placeOnCalendar()'s follow-up write in assignments/service.ts). Backs
  // the re-keyed WorkerAssignment_active_slot_unique partial index below,
  // which spans every creation path uniformly (unlike the prior
  // work_request_id-scoped index, which could not see a competing
  // calendar-placed or future broadcast-accept assignment on the same day).
  day DateTime @db.Date

  // Relations — each assignment yields at most one attendance record, one QV, one rating,
  // one rooms-completed entry (ADR-028)
  attendance            Attendance?
  quality_verification  QualityVerification?
  rating                Rating?
  rooms_completed_entry RoomsCompletedEntry?
  // Epic 9 PR 9.5 (TREQ-001/MIG-GAP-03): 1:1 with the CalendarEntry created by
  // placeOnCalendar() in the same transaction — present only for
  // calendar-placed assignments (absent for broadcast-accept rows, PR 9.9).
  calendar_entry        CalendarEntry?

  // SP-5: full unique constraint removed. Active-slot double-booking is enforced
  // by the partial unique index in the migration (status IN CONFIRMED, IN_PROGRESS).
  // Epic 9 PR 9.6: re-keyed from (work_request_id, worker_id) to (worker_id,
  // day) -- see WorkerAssignment_active_slot_unique in
  // 20260729030000_add_worker_assignment_day_exclusivity/migration.sql.
  @@index([work_request_id])
  @@index([job_request_id])
  @@index([worker_id])
  @@index([hotel_id])
  @@index([status])
  @@index([confirmed_at])
  @@index([day])
}

// Epic 9 PR 9.5 (TREQ-001/TRULE-001, MIG-GAP-03): per-worker per-day
// assignment-kind record for a manager's DIRECT calendar placement (no
// worker accept/decline step). Owned by backend-assignments (ADR-021's
// "assignment creation... remain owned by Job Dispatch/backend-assignments"),
// NOT backend-calendar — deliberately narrow and non-overlapping with
// Calendar's own state-calendar-absence/CalendarAbsence model (sick/vacation
// marks, ADR-021 Correction v0.3.1): this model records only that a worker
// has an assignment on a given day, not any leave/absence state.
// 1:1 with WorkerAssignment, created in the same transaction by
// placeOnCalendar() (assignments/service.ts) — mirrors RoomsCompletedEntry's
// 1:1-per-assignment shape (schema.prisma:725-744).
model CalendarEntry {
  id            String           @id @default(cuid())
  assignment_id String           @unique
  assignment    WorkerAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  worker_id     String
  worker        User             @relation("calendar_entry_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  hotel_id      String
  hotel         Hotel            @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  // Date-only (no time component) — the specific day being placed, mirroring
  // CalendarAbsence.day's own shape (schema.prisma:922-923) so both models
  // key "one record per worker per day" identically.
  day           DateTime         @db.Date
  placed_by_id  String
  placed_by     User             @relation("calendar_entry_placed_by", fields: [placed_by_id], references: [id], onDelete: Restrict)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  // TRULE-001/TRULE-006 (daily exclusivity groundwork — full DB-level
  // enforcement is PR 9.6's partial unique index re-keying; this unique
  // constraint only guards against a duplicate CalendarEntry for the same
  // worker/day within this PR's own creation path, not against a competing
  // broadcast-accept assignment on the same day).
  @@unique([worker_id, day])
  @@index([worker_id])
  @@index([hotel_id])
  @@index([day])
}

// =============================================================================
// ATTENDANCE MODULE
// =============================================================================

// SP-6: status defaults to EXPECTED (pre-shift state before worker arrives).
// SP-7: is_verified flag added for efficient manager-dashboard queries.
model Attendance {
  id             String             @id @default(cuid())
  assignment_id  String             @unique // 1-to-1 with WorkerAssignment
  assignment     WorkerAssignment   @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  worker_id      String
  worker         User               @relation("attendee", fields: [worker_id], references: [id], onDelete: Cascade)
  hotel_id       String
  hotel          Hotel              @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  status         AttendanceStatus   @default(EXPECTED) // SP-6
  check_in_at    DateTime?
  check_out_at   DateTime?
  // Denormalised from WorkRequest so payroll/reporting queries need no extra join
  expected_start DateTime?
  expected_end   DateTime?
  minutes_late   Int?
  minutes_worked Int?
  notes          String?
  is_verified    Boolean            @default(false) // SP-7: set true when manager verifies
  verified_by_id String?
  verified_by    User?              @relation("attendance_verifier", fields: [verified_by_id], references: [id], onDelete: SetNull)
  verified_at    DateTime?
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  // OD-GEO-010: geofence-verification events captured by GeoService.verifyGeofence
  // during this shift's check-in/check-out (backend-geo-owned table; see
  // WorkerGeoCheckin.attendance_id).
  geo_checkins   WorkerGeoCheckin[]

  @@index([worker_id])
  @@index([hotel_id])
  @@index([status])
  @@index([check_in_at])
  @@index([worker_id, check_in_at]) // "worker's shifts in date range"
  @@index([hotel_id, is_verified]) // SP-7: "pending verifications" dashboard
}

// =============================================================================
// QUALITY MODULE
// =============================================================================

model QualityVerification {
  id                  String             @id @default(cuid())
  assignment_id       String             @unique // 1-to-1 with WorkerAssignment
  assignment          WorkerAssignment   @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  hotel_id            String
  hotel               Hotel              @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  verified_by_id      String
  verified_by         User               @relation("verifier", fields: [verified_by_id], references: [id], onDelete: Restrict)
  score               Int // 0–100; CHECK constraint in migration
  status              VerificationStatus @default(PASSED)
  notes               String?
  photo_urls          String[] // evidence uploaded to object storage
  rework_required     Boolean            @default(false)
  rework_notes        String?
  rework_completed_at DateTime?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  @@index([hotel_id])
  @@index([verified_by_id])
  @@index([status])
  @@index([score])
}

model Rating {
  id              String           @id @default(cuid())
  assignment_id   String           @unique // 1-to-1 with WorkerAssignment
  assignment      WorkerAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  hotel_id        String
  hotel           Hotel            @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  worker_id       String
  worker          User             @relation("rated_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  rated_by_id     String
  rated_by        User             @relation("rater", fields: [rated_by_id], references: [id], onDelete: Restrict)
  score           Int // 0–100; rescaled from 1–5 stars by ADR-026; CHECK constraint in migration
  comment         String?
  // Structured sub-scores; schema: { punctuality: Int, quality: Int, attitude: Int }
  criteria_scores Json?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@index([hotel_id])
  @@index([worker_id])
  @@index([rated_by_id])
  @@index([score])
  @@index([created_at])
}

// Materialised aggregate — updated by DB trigger after each Rating write.
// Avoids expensive AVG() scans on marketplace listing pages.
model WorkerOverallRating {
  id                String    @id @default(cuid())
  worker_id         String    @unique
  worker            User      @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  average_score     Float // rolling average of Rating.score
  total_ratings     Int       @default(0)
  total_assignments Int       @default(0)
  completion_rate   Float     @default(0.0) // completed / total assignments
  on_time_rate      Float     @default(0.0) // present-on-time / total assignments
  last_worked_at    DateTime?
  updated_at        DateTime  @updatedAt

  @@index([average_score])
  @@index([total_ratings])
}

// ADR-028 (OQ-ANALYTICS-03): "rooms completed per worker" is retained as a basic-
// analytics metric (REQ-ANALYTICS-013), but is NOT a room-level task record — CONFIRMED
// §33 rules out any room-level task layer ("Task"/"Work Request" do NOT need
// separating; full-day employment model). Instead this is a manager-entered daily
// count tied 1-to-1 to the worker's full-day WorkerAssignment, mirroring the
// Attendance/QualityVerification/Rating precedent (denormalised hotel_id/worker_id,
// one row per assignment, entered_by is the acting manager). Deliberately NOT added
// to ReceptionData (PIVOT §9.3: "Manager-entered checkout / long-stay data" only,
// out of scope for this field per its own definition).
model RoomsCompletedEntry {
  id              String           @id @default(cuid())
  assignment_id   String           @unique // 1-to-1 with WorkerAssignment — the worker's full-day assignment
  assignment      WorkerAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  hotel_id        String
  hotel           Hotel            @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  worker_id       String
  worker          User             @relation("rooms_completed_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  entered_by_id   String
  entered_by      User             @relation("rooms_completed_entered_by", fields: [entered_by_id], references: [id], onDelete: Restrict)
  rooms_completed Int // manager-entered count; CHECK >= 0 in migration
  notes           String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@index([hotel_id])
  @@index([worker_id])
  @@index([entered_by_id])
  @@index([created_at])
}

// =============================================================================
// NOTIFICATIONS MODULE
// =============================================================================

// SP-8: type promoted from String to NotificationType enum.
model Notification {
  id         String              @id @default(cuid())
  user_id    String
  user       User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  hotel_id   String?
  hotel      Hotel?              @relation(fields: [hotel_id], references: [id], onDelete: SetNull)
  type       NotificationType // SP-8: was String
  channel    NotificationChannel @default(IN_APP)
  title      String
  message    String
  data       Json? // resource IDs for deep-linking
  is_read    Boolean             @default(false)
  read_at    DateTime?
  sent_at    DateTime?
  expires_at DateTime?
  created_at DateTime            @default(now())

  @@index([user_id])
  @@index([hotel_id])
  @@index([type])
  @@index([created_at])
  @@index([user_id, is_read]) // hot path: unread notification badge count
}

// ADR-029 (2026-07-23, GD-01: Transactional Outbox + Platform Worker). Internal
// delivery/queue record, owned exclusively by backend-notifications — no other
// module writes this table directly; every producer goes through
// notificationService.enqueue() (single-writer discipline, same as Notification
// above). Never exposed to any client. PR 7.1 scope: model + transactional
// enqueue() only — no reads/transitions by a Platform Worker (that is PR 7.2,
// which does not exist yet). Deliberately no foreign keys (ADR-029; an internal
// ledger, not a relation the domain model needs to join through) — additive,
// reversible migration (drop table + 5 enums).
model OutboxEvent {
  id               String              @id @default(cuid())
  event_id         String              @unique @default(uuid()) // per-row idempotency key (ADR-029 §7); provider-side dedup key where the transport supports one
  correlation_id   String              @default(uuid()) // shared across every OutboxEvent row produced by one enqueue() call (one logical notification, N transports)
  event_type       OutboxEventType
  aggregate_type   OutboxAggregateType
  aggregate_id     String // canonical reference (e.g. the sibling Notification.id) — the Platform Worker resolves the aggregate from this column, never from payload
  source_module    OutboxSourceModule
  producer_service String // e.g. "AttendanceService" — a class-name identity, not an enum (churns on refactor; source_module is the stable identity)
  transport        OutboxTransport
  status           OutboxStatus        @default(PENDING)
  payload          Json // domain body ONLY — metadata (event_id, correlation_id, aggregate_*, etc.) is column-sourced, never duplicated into this JSON (ADR-029 §9)
  payload_version  Int                 @default(1)
  scheduled_for    DateTime            @default(now()) // producer intent: when this event should first become eligible; immutable after creation
  next_attempt_at  DateTime            @default(now()) // live retry clock the Platform Worker claims against; initialized to scheduled_for, advanced by backoff on retry (PR 7.2)
  attempts         Int                 @default(0)
  last_error       String?
  processed_at     DateTime? // set on the terminal DELIVERED/DEAD_LETTER transition (PR 7.2); basis for delivery_latency = processed_at - created_at
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  @@index([status, next_attempt_at]) // Platform Worker claim hot path (PR 7.2)
  @@index([correlation_id])
  @@index([aggregate_type, aggregate_id])
  @@index([created_at])
}

// Epic 7 PR 7.5 (ADR-029 §4, Consequences: "a PushToken model for PUSH").
// One row per registered device. `token` is the unique key (not
// user_id+token, deliberately): a device token is device-specific, so
// re-registering the SAME token under a different user reassigns ownership
// (upsert-by-token in NotificationService.registerPushToken) — the correct
// behavior when a different user logs into an already-registered device,
// avoiding delivering pushes to the wrong account. Owned exclusively by
// backend-notifications, same single-writer discipline as Notification/
// OutboxEvent above. Cascade-deletes with its User (mirrors Notification).
model PushToken {
  id         String       @id @default(cuid())
  token      String       @unique
  platform   PushPlatform
  // Epic 7 PR 7.8: the originating app, used to select the correct APNs topic
  // at delivery time (see the PushApp enum). NOT NULL and no default —
  // registration always supplies it, so the transport may assume it exists
  // rather than every future code path handling an impossible null state.
  app        PushApp
  user_id    String
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  @@index([user_id])
}

// =============================================================================
// COMPLIANCE MODULE
// =============================================================================

model AuditLog {
  id            String    @id @default(cuid())
  actor_id      String?
  actor         User?     @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  actor_role    UserRole?
  action        String // "CREATE" | "READ" | "UPDATE" | "DELETE" | "APPROVE" | "REJECT" | "ASSIGN"
  resource_id   String
  resource_type String // "WORK_REQUEST" | "APPLICATION" | "ASSIGNMENT" | "ATTENDANCE" | "RATING" etc.
  old_values    Json? // previous state snapshot for UPDATE/DELETE
  new_values    Json? // new state snapshot for CREATE/UPDATE
  details       Json? // additional freeform context
  ip_address    String?
  user_agent    String?
  timestamp     DateTime  @default(now())

  // AuditLog rows are never mutated; no updated_at
  @@index([actor_id])
  @@index([action])
  @@index([resource_type])
  @@index([resource_id])
  @@index([timestamp])
  @@index([resource_type, resource_id]) // "full history of a resource"
}

// =============================================================================
// DOCUMENTS MODULE (SPEC-DOCUMENTS-001 @0.1.4 FROZEN, GD-16 Decided 2026-07-27)
// =============================================================================

// CRR §7 lines 97-98, ADR-065 §6 item 8: Named-document checklist model
// applying identically to every non-Admin role (Worker, Checker, Manager, Regional Manager).
enum DocumentCategory {
  TAX_NUMBER // Tax identification number
  SOCIAL_SECURITY_NUMBER // Sozialversicherungsnummer
  HEALTH_INSURANCE // Health insurance proof/membership document
  ID_CARD // National identity card
  PASSPORT // Passport (Required independently of ID_CARD)
  ADDRESS // Proof of address
  WORK_PERMIT // Residence/work-authorization document (Required conditionally per work_permit_required flag)
}

// state-worker-document (SPEC-DOCUMENTS-001, PDD §9.3 line 389).
// Canonical target-state entity name is WorkerDocument -- not "Document" (PDD §9.3).
// Actors: self-upload (worker) or manager-upload (contract-scan mechanism, RULE-DOC-04).
// All document bytes live in S3 (EU); this table stores metadata only (REQ-DOC-007).
// Retention tier: OD-DOC-001 (open; not yet mapped to CRR §25 tier).
// Special-category applicability: OD-DOC-002 (no confirmed special-category doc type today).
model WorkerDocument {
  id                String           @id @default(cuid())
  worker_id         String
  worker            User             @relation("documents_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  // Uploader identity — always derived from the authenticated session (RULE-DOC-08).
  // For worker self-uploads: uploaded_by_id == worker_id.
  // For manager-on-behalf uploads (contract-scan mechanism): uploaded_by_id == manager's user id.
  uploaded_by_id    String
  uploaded_by       User             @relation("documents_uploader", fields: [uploaded_by_id], references: [id])
  category          DocumentCategory
  // Server-generated storage key (RULE-DOC-09): never built from client input;
  // includes a UUIDv4 segment for unpredictability (OD-DOC-017).
  s3_key            String           @unique
  original_filename String
  mime_type         String
  file_size_bytes   Int
  // REQ-DOC-001: expiry tracking. Consequence/warning on crossing is OD-DOC-003 (open).
  expires_at        DateTime?        @db.Date
  // REQ-DOC-003: true only for non-EU/EEA/Swiss workers' work-permit documents.
  is_work_permit    Boolean          @default(false)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  // SPEC-HR-001 (MIG-GAP-DOC-001): back-relation for a Contract's scanned
  // signed copy — HR delegates storage here, does not duplicate it
  // (RULE-DOC-04: this delegation grants HR no document-lifecycle authority).
  hr_contract_scan  Contract?        @relation("hr_contract_scan")

  // OD-DOC-019 (FIND-PERF-001): compound index required at schema-creation time.
  @@index([worker_id, category])
  @@index([worker_id])
}

// =============================================================================
// CALENDAR MODULE (SPEC-CALENDAR-001, narrow ADR-021 slice)
// =============================================================================

// state-calendar-absence (SPEC-CALENDAR-001 REQ-CAL-T08): Calendar-owned,
// distinct from Job Dispatch's CalendarEntry/WorkerAssignment (ADR-021).
// Stores only a plain sick/vacation flag -- no health data (CRR §27 §353),
// no leave-balance accounting (non-goal, REQ-CAL-T07).
model CalendarAbsence {
  id           String              @id @default(cuid())
  worker_id    String
  worker       User                @relation("calendar_absence_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  // Date-only (no time component); the specific day being marked, not a range.
  day          DateTime            @db.Date
  kind         CalendarAbsenceKind
  // Reason text (2026-08-08 feature): mandatory for VACATION ("family trip",
  // "personal day" -- low sensitivity), nullable for SICK. A SICK reason is
  // deliberately NOT made mandatory: forcing detail on a sick day is exactly
  // the health-data-collection pattern this model's "no health data" design
  // (CRR §27 §353) exists to avoid -- GDPR special-category data (health)
  // needs protections this system doesn't have. Enforced in the Zod schema
  // (types.ts), not a DB-level CHECK, so the column itself stays plain
  // nullable text.
  reason       String?
  // Who actually performed the mark/move (2026-08-08 feature: manager may now
  // act on a worker's behalf, not just self-service) -- distinct from
  // worker_id, whose absence this is. Nullable/SetNull rather than required:
  // an actor account being later deleted must not cascade-delete the
  // absence record itself, mirroring WorkerAssignment.assigned_by_id and
  // CalendarEntry.placed_by_id's identical shape. AuditLog is the
  // authoritative, immutable record of who/when for compliance; this column
  // is a denormalized convenience for the calendar UI to show "marked by
  // <manager>" without joining AuditLog.
  marked_by_id String?
  marked_by    User?               @relation("calendar_absence_marked_by", fields: [marked_by_id], references: [id], onDelete: SetNull)
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  // RULE-CAL-03: one mark per worker per day.
  @@unique([worker_id, day])
  @@index([worker_id])
  @@index([day])
}

// =============================================================================
// GEO MODULE (SPEC-GEO-001 @0.1.2 FROZEN, GD-14 Decided 2026-07-27)
// =============================================================================

// state-worker-geo-checkin (SPEC-GEO-001 TREQ-GEO-004/005, RULE-GEO-004):
// backend-geo-owned (OD-GEO-002) -- the ONLY module that writes/reads this
// model. Distinct from Hotel.latitude/longitude (backend-crm-owned,
// OD-GEO-001) and from Attendance's own CHECK_IN/UPDATE_ATTENDANCE record --
// this row is the captured device coordinate + computed distance for one
// geofence check, not an attendance-state transition (backend-attendance
// remains sole owner of that, unmodified by this module).
//
// RULE-GEO-003/OD-GEO-005: raw latitude/longitude are stored here but MUST
// NEVER be returned by any admin/manager-facing API -- only distance_meters
// and inside_radius are exposed cross-role. Enforced in service.ts's DTO
// mapping, not by the schema itself.
model WorkerGeoCheckin {
  id              String      @id @default(cuid())
  worker_id       String
  worker          User        @relation("geo_checkin_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  hotel_id        String
  hotel           Hotel       @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  // OD-GEO-010: the shift this check verified, when the check originated
  // from Attendance's own checkIn()/checkOut() (GD-14 backend-attendance <->
  // backend-geo wiring). Nullable because GeoController.checkIn's
  // standalone worker-facing "Verify Location" endpoint has no attendance
  // record to attach to -- an exact link where one exists is strictly
  // better than the worker_id+hotel_id+time-window heuristic callers used
  // before this field existed. onDelete: SetNull, not Cascade: the geo
  // audit trail (GDPR Tier 1, 6-month retention) must survive the
  // Attendance row's own lifecycle rather than being deleted alongside it.
  attendance_id   String?
  attendance      Attendance? @relation(fields: [attendance_id], references: [id], onDelete: SetNull)
  // Raw device coordinates (RULE-GEO-002: sampled only at this single check,
  // never continuous/background). Personal location data -- GDPR Tier 1.
  latitude        Float
  longitude       Float
  // Computed at write time (RULE-GEO-001): distance_meters is exposed to
  // admin/manager; latitude/longitude above are not (OD-GEO-005).
  distance_meters Float
  inside_radius   Boolean
  checked_at      DateTime    @default(now())

  // RULE-GEO-004/TREQ-GEO-005: 6-month hard-delete retention sweep scans on
  // checked_at, not created_at, to match "6 months after capture" precisely
  // (the two are identical at write time, but checked_at is the
  // spec-cited field).
  @@index([worker_id])
  @@index([hotel_id])
  @@index([checked_at])
  @@index([attendance_id])
}

// =============================================================================
// HR MODULE (SPEC-HR-001, ADR-012/ADR-014 bounded context; PR 1 of the HR
// implementation plan following the backend-hr/SPEC-EMP-001 boundary review)
// =============================================================================

// state-hr-contract (SPEC-HR-001 REQ-HR-001..007, RULE-HR-01..07). Owned
// exclusively by backend-hr (ADR-012, Accepted 2026-07-12: contract
// lifecycle/generation/templates/versions/signatures/manager-confirmation is
// backend-hr's capability; Onboarding/employee-management consume, not own).
// Contract PDF generation reads Personalfragebogen-sourced data from the
// PERSISTED employee-management record (EmploymentRecord.personal_data),
// not a transient Onboarding source — OD-HR-02b, resolved per the HR
// boundary review: SPEC-EMP-001's own REQ-EMP-011 already designs
// EmploymentRecord as that persisted store, no onboarding module exists in
// code to read a transient source from, and CRR §6 (Personalfragebogen at
// signup) precedes CRR §9 (contract, post-familiarization) so the data is
// already persisted by generation time. HR reads EmploymentRecord directly
// via Prisma (this.prisma.employmentRecord.findUnique), the same
// already-established cross-module read pattern calendar/service.ts and
// job-requests/service.ts already use — not a new service-layer coupling.
enum ContractStatus {
  PENDING // generated, awaiting scan-upload + manager confirmation (RULE-HR-01)
  ACTIVE // manager-confirmed "signed & valid" (RULE-HR-03); 1-year clock started (RULE-HR-05)
  EXTENDED // +1 year, no new probation (RULE-HR-06)
  PERMANENT // open-ended, no further expiry reminders (RULE-HR-06)
}

model Contract {
  id                   String          @id @default(cuid())
  worker_id            String
  worker               User            @relation("hr_contract_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  template_id          String // ADR-039: no salary/compensation field — document production only
  position             String
  start_date           DateTime        @db.Date
  // Defaults to start_date + 6 months at creation (hr/service.ts
  // createContract(), 2026-08-13) — end date is provisional and remains
  // editable later (e.g. on extend/confirm); NOT enforced against
  // employment_type below (a part-time contract is not required to be
  // shorter than a full-time one).
  end_date             DateTime?       @db.Date
  // Mandatory marking carried over from EmploymentRecord.employment_type at
  // the moment this contract is generated (2026-08-13 contract feature) —
  // determines which pre-printed FULL_TIME/PART_TIME marking the applicant
  // is expected to select on the downloaded default contract PDF. The
  // manager reviews the returned scan manually (RULE-HR-03); this field is
  // never machine-checked against the scan content.
  employment_type      EmploymentType
  status               ContractStatus  @default(PENDING)
  // Generated PDF reference (RULE-HR-01) and the manager-uploaded scanned
  // signed copy (RULE-HR-03) — both S3 EU object keys (REQ-HR-008), never
  // built from unsanitized client input (RULE-HR-13). scanned_document_id
  // links to the WorkerDocument row created via the existing
  // backend-documents delegation (MIG-GAP-DOC-001, hr/service.ts
  // uploadDocument()) — HR does not duplicate document storage.
  generated_pdf_key    String?
  scanned_document_id  String?         @unique
  scanned_document     WorkerDocument? @relation("hr_contract_scan", fields: [scanned_document_id], references: [id], onDelete: SetNull)
  // Manager-confirmation event (RULE-HR-03/REQ-HR-013): who, when. Actor id
  // MUST be derived from req.auth (RULE-HR-14), never client-supplied.
  confirmed_by_id      String?
  confirmed_by         User?           @relation("hr_contract_confirmed_by", fields: [confirmed_by_id], references: [id], onDelete: SetNull)
  confirmed_at         DateTime?
  // Expiry-clock/reminder scheduling state (RULE-HR-05/07, REQ-HR-007):
  // populated once status flips to ACTIVE; reminders fire at 1yr/2yr marks,
  // none once PERMANENT (RULE-HR-06).
  expires_at           DateTime?
  reminder_1yr_sent_at DateTime?
  reminder_2yr_sent_at DateTime?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  @@index([worker_id])
  @@index([status])
  @@index([expires_at])
}

// state-hr-payslip-request (SPEC-HR-001 REQ-HR-009/012, RULE-HR-09/12).
// ADR-039: request-only tracking — zero payroll computation, no
// gross-salary/wage-calculation field of any kind (backend-hr never
// computes payroll; an external provider or manual process does, outside
// this system). ADR-014 (Accepted 2026-07-13): backend-hr is the exclusive
// owner of this capability; no standalone Payslips module exists.
enum PayslipRequestStatus {
  REQUESTED // worker submitted a request (RULE-HR-09)
  FULFILLED // manager marked the request emailed to the worker (RULE-HR-09)
}

model PayslipRequest {
  id              String               @id @default(cuid())
  worker_id       String
  worker          User                 @relation("hr_payslip_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  period_start    DateTime             @db.Date
  period_end      DateTime             @db.Date
  status          PayslipRequestStatus @default(REQUESTED)
  fulfilled_by_id String?
  fulfilled_by    User?                @relation("hr_payslip_fulfilled_by", fields: [fulfilled_by_id], references: [id], onDelete: SetNull)
  fulfilled_at    DateTime?
  // ADR-041 (2026-07-28): 3-business-day auto-escalation to the manager's
  // own manager (or Admin fallback, pending GD-03's org-chart model) via the
  // existing Outbox — a notification, not a new state. escalated_at is set
  // once, not repeated, so the scheduled job can skip already-escalated rows.
  escalated_at    DateTime?
  // Tier-3 retention classification (REQ-HR-012; CRR §25 payroll/tax-adjacent
  // fields, 6 years) — metadata only; no RetentionTier enum exists yet
  // platform-wide (backend-retention is zero-code, GD-09 mapping decided but
  // module unbuilt), matching the convention every other module's Tier-3
  // fields use today (comment-documented, not a foreign-keyed enum).
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  @@index([worker_id])
  @@index([status])
}

// Consent implementation (SPEC-CONSENT-001@0.2.0 FROZEN, ADR-015/ADR-037,
// GD-17 Decided 2026-07-28). ADR-015: backend-consent is the exclusive owner
// of consent lifecycle/records/versions/withdrawal/renewal/audit history
// platform-wide -- no other module may persist a competing consent-state
// model (RULE-CONSENT-09).
//
// OD-CONSENT-001/007 (ADR-037): "Renewed" is a distinct persisted decision
// for the general withdrawal/renewal verb; the daily access-gate instance's
// own grant/decline cycle stays purely date-computed -- a fresh GRANTED row
// per calendar day, no separate "Lapsed"/"Renewed" row at that layer.
// "Requested" is transient (a pending ask not yet answered), never a
// persisted row.
enum ConsentDecision {
  GRANTED
  DECLINED
  WITHDRAWN
  RENEWED
}

model ConsentRecord {
  id               String          @id @default(cuid())
  worker_id        String
  worker           User            @relation("consent_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  // Consent instance identifier (RULE-CONSENT-01/06), e.g. "daily-access-gate"
  // or "chatbot-data-processing" -- not a foreign-keyed enum, since ADR-015
  // frames this module as owning a general consent-record model of which the
  // daily gate is only the first confirmed instance (OD-CONSENT-002 adds the
  // second, chatbot-data-processing).
  consent_instance String
  notice_version   String
  decision         ConsentDecision
  // RULE-CONSENT-05: every consent decision is immutable -- no update/delete
  // code path exists anywhere in HrService-equivalent ConsentService.
  decided_at       DateTime        @default(now())
  created_at       DateTime        @default(now())

  // RULE-CONSENT-02: the daily gate's "once per calendar day" rule is
  // evaluated by comparing decided_at's calendar date against "today" at
  // query time (isGrantedToday()-equivalent) -- no separate "day" column is
  // needed since decided_at already carries this.
  @@index([worker_id, consent_instance])
  @@index([decided_at])
}

// Retention schema (SPEC-RETENTION-001@0.2.0, REVIEW -- NOT FROZEN; schema-
// only PR 1 of the planned 5-PR implementation sequence: schema -> core
// interfaces -> sweep engine -> audit -> eligibility API). No service,
// controller, route, or scheduler code is introduced by this PR --
// RetentionTier/RetentionCategory/RetentionLog/RetentionAuditEntry exist
// only as persisted shape for later PRs to build against.
//
// Scope: this module is generic, reusable retention infrastructure (tier
// registration, eligibility, scheduling framework, audit, deletion-contract
// interfaces) for any consuming module that has not already built its own
// retention mechanism. It does not own backend-geo's Tier-1 sweep
// (GeoRetentionSweepJob, SIR-GEO-002/OD-GEO-002, resolved by GD-14) -- see
// MODULE_SPEC.md's Purpose and Scope / RULE-RETENTION-08.
//
// RULE-RETENTION-01: exactly the three CRR §25-confirmed tiers exist as a
// closed set; no fourth tier or alternate window. The window each tier
// implies (6 months / 5 years / 6 years) is intentionally NOT encoded here
// as separate enum values or columns. REQ-RETENTION-013's own acceptance
// criterion requires each tier be "queryable as a distinct, stable tier
// identifier with its window encoded" but does not itself say where that
// encoding must live -- keeping the window in service-layer logic (PR 2+)
// rather than a schema column is this PR's own implementation-time choice,
// not something the requirement text dictates either way.
enum RetentionTier {
  TIER_1
  TIER_2
  TIER_3
}

// REQ-RETENTION-014 (MUST): "IF-RETENTION-RegisterCategory accepts a
// consuming-module-supplied category identifier and a tier assignment, and
// persists that mapping in RetentionLog's category-tracking state." This
// model is that persisted category-tracking state -- the registration half
// of what the spec's prose calls "RetentionLog" (the spec names one
// conceptual entity; see RetentionLog below for why this PR splits it into
// three models). Named RetentionCategory rather than e.g. "...Registration"
// to match the spec's own Actors and Terminology vocabulary ("Retention
// category / data category", MODULE_SPEC.md line 85) instead of its
// "Registration / tagging" term (line 88), which names the act, not the
// persisted entity.
//
// RULE-RETENTION-02: a consuming module registers/tags its own category
// here, supplying its own tier assignment -- this module never infers it
// (REQ-RETENTION-019/RULE-RETENTION-07).
//
// The unique constraint on (module_id, category_id) gives a future
// service-layer check something to enforce against; it does NOT resolve
// OD-RETENTION-03 (duplicate registration with a conflicting tier is still
// an explicitly OPEN decision -- out of scope for this schema-only PR).
model RetentionCategory {
  id          String        @id @default(cuid())
  // Consuming-module identifier, module-scoped (e.g. "attendance").
  module_id   String
  // Category identifier, scoped within module_id (e.g. "shift_coordinate").
  category_id String
  tier        RetentionTier
  created_at  DateTime      @default(now())

  logs RetentionLog[]

  @@unique([module_id, category_id])
}

// REQ-RETENTION-015 (MUST) / RULE-RETENTION-03: tracks per-record (or
// per-category, depending on tagging granularity -- OD-RETENTION-04 is
// still OPEN and not resolved by this schema) deletion-eligibility state
// prior to deletion. This is the "Tagged/Tracked -> Eligible" half of the
// State and Lifecycle section.
//
// Deliberately split from RetentionCategory (registration) and from
// RetentionAuditEntry (immutable post-deletion record) into its own model:
// the spec names a single "RetentionLog" entity, but its two described
// responsibilities -- eligibility tracking (queried/updated repeatedly
// pre-deletion) vs. deletion audit (write-once, must never be updated,
// RULE-RETENTION-06) -- have incompatible mutability characteristics. This
// PR keeps the RetentionLog name for the pre-deletion tracking half (closest
// to PDD §9.3's "tracks deletion eligibility per data category" framing)
// and introduces RetentionAuditEntry as a distinct immutable audit model
// (see below). This is a disclosed implementation-time schema-shape choice,
// not a spec violation -- the spec does not prescribe schema granularity.
//
// category relation (not a denormalized module_id/category_id pair):
// RULE-RETENTION-07 requires "unregistered categories are never swept" --
// a foreign key to RetentionCategory structurally enforces that a
// RetentionLog row can never exist without a registered category, which a
// denormalized pair alone would not guarantee.
model RetentionLog {
  id          String            @id @default(cuid())
  category_id String
  category    RetentionCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  // Opaque cross-module record reference (module-scoped id sufficient for
  // the owning module to identify the record on its own side) -- NOT a
  // Prisma relation/foreign key, since the referenced record lives in
  // another module's own table, outside this module's schema ownership
  // (Ownership and Boundaries: this module never owns/redefines another
  // module's business record).
  record_ref  String
  // RULE-RETENTION-03: the clock the tier's window counts from (the
  // record's creation/effective timestamp, per IF-RETENTION-TagRecord).
  tagged_at   DateTime
  // Set once the sweep (PR 3+) determines and/or executes deletion for this
  // row. deleted_at null == still Tagged/Tracked or Eligible; non-null ==
  // Deleted (RULE-RETENTION-05). No business logic for computing eligibility
  // or performing deletion is implemented in this PR.
  deleted_at  DateTime?
  created_at  DateTime          @default(now())

  @@index([category_id])
  @@index([tagged_at])
  @@index([deleted_at])
}

// REQ-RETENTION-018 (MUST) / RULE-RETENTION-06: every deletion performed by
// the sweep produces an immutable audit entry recording category, tier, and
// timestamp only -- never the deleted personal data. Kept as a distinct
// model from RetentionLog (see reasoning above): audit rows must never be
// updated once written, unlike RetentionLog's pre-deletion tracking rows.
//
// Denormalized module_id/category_id/tier (rather than a foreign key to
// RetentionCategory) so this audit trail survives even if the originating
// RetentionCategory or RetentionLog row is ever removed -- an audit record
// of "what was deleted, under which tier, and when" (Purpose and Scope)
// must remain independently readable. No personal-data field exists on this
// model by construction, matching IF-RETENTION-GetDeletionAuditLog's
// fixed-field output allow-list (FIND-SEC-003).
//
// deleted_at has no default: it must be explicitly supplied as the actual
// deletion instant by whatever writes this row (PR 3+'s sweep). An
// @default(now()) here would risk silently recording audit-write time
// instead of deletion time if the write is ever delayed/retried/batched --
// created_at (row-insertion time) already exists separately for that
// purpose, so deleted_at is free to mean exactly what RULE-RETENTION-06's
// "timestamp" refers to: when the delete happened, not when the audit
// entry was written.
model RetentionAuditEntry {
  id          String        @id @default(cuid())
  module_id   String
  category_id String
  tier        RetentionTier
  deleted_at  DateTime
  created_at  DateTime      @default(now())

  @@index([module_id, category_id])
  @@index([deleted_at])
}

model DailyShiftSummary {
  id                   String   @id @default(uuid())
  hotel_id             String
  date                 DateTime // Anchored to 00:00:00 UTC for the local day
  total_rooms          Int
  stay_over_rooms      Int
  checkout_rooms       Int
  total_people_working Int
  notes                String?

  created_by_id String
  updated_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  hotel      Hotel @relation(fields: [hotel_id], references: [id], onDelete: Restrict)
  created_by User  @relation("ShiftSummaryCreator", fields: [created_by_id], references: [id], onDelete: Restrict)
  updated_by User? @relation("ShiftSummaryUpdater", fields: [updated_by_id], references: [id], onDelete: Restrict)

  @@unique([hotel_id, date])
  @@index([hotel_id])
}

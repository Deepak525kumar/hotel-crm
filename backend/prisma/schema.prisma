// =============================================================================
// Hotel CRM — PRISMA_SCHEMA_V2  (PATCH_V1 applied)
// Architecture: Marketplace (hotels post requests, workers apply)
// Removed: Room, Task, TaskPhoto, DailyOperation
// Added: HotelWorker, WorkApplication, Attendance
// Patch: SP-1..SP-9 applied
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  WORKER
  CHECKER
  MANAGER
  ADMIN
  // ADR-030 D-5/M-1: additive-only (Postgres ALTER TYPE ADD VALUE). Gained no
  // MASTER capability; operational manager at hotel_group scope (D-5).
  // Promotion of existing group-associated managers happens via M-3, gated by
  // FEATURE_RM_ROLE — this enum value alone authorizes nothing (ADR-030 §6 PR-2, D-6).
  REGIONAL_MANAGER
}

// SP-1: INACTIVE removed; INVITED + REMOVED added to match frozen lifecycle.
// Lifecycle: INVITED → ACTIVE → SUSPENDED ↔ ACTIVE; ACTIVE/SUSPENDED → REMOVED (terminal)
enum HotelWorkerStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WorkRequestStatus {
  DRAFT
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
}

enum AssignmentStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
  REASSIGNED
}

// GD-18 narrow slice: SPEC-CALENDAR-001 REQ-CAL-T03/T08. Calendar-owned only —
// distinct from Job Dispatch's CalendarEntry/WorkerAssignment (ADR-021).
enum CalendarAbsenceKind {
  SICK
  VACATION
}

// SP-6: EXPECTED added as the initial pre-shift state; default changed to EXPECTED.
enum AttendanceStatus {
  EXPECTED  // record created pre-shift; worker not yet checked in
  PRESENT
  ABSENT
  LATE
  PARTIAL
  EXCUSED
}

enum VerificationStatus {
  PASSED
  FAILED
  NEEDS_REWORK
}

// ADR-027 (2026-07-22, OQ-NOTIF-01): the canonical channel set is exactly these five
// members. Provider-specific integrations (WhatsApp, Slack, etc.) are a transport
// detail under one of these channels (e.g. WEBHOOK), never a new enum member.
enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
  WEBHOOK
}

// SP-8: Notification.type promoted from String to NotificationType enum.
// All values are domain events; free strings are not acceptable here.
enum NotificationType {
  // WorkRequest events
  WORK_REQUEST_PUBLISHED
  WORK_REQUEST_CANCELLED
  WORK_REQUEST_EXPIRING_SOON
  // WorkApplication events
  APPLICATION_RECEIVED       // to manager: a worker applied
  APPLICATION_ACCEPTED       // to worker: application approved
  APPLICATION_REJECTED       // to worker: application declined
  APPLICATION_WITHDRAWN      // to manager: worker withdrew
  // WorkerAssignment events
  ASSIGNMENT_CONFIRMED
  ASSIGNMENT_CANCELLED
  SHIFT_REMINDER             // pre-shift reminder to worker
  CHECK_IN_REMINDER          // sent when shift start approaches with no check-in
  // Attendance events
  ATTENDANCE_VERIFIED        // to worker: manager verified attendance
  WORKER_NO_SHOW             // to manager: worker did not check in
  // Quality & Rating events
  QUALITY_VERIFICATION_SUBMITTED
  RATING_RECEIVED
  REWORK_REQUIRED            // to worker: verification failed, rework needed
  // Calendar events (SPEC-CALENDAR-001, RULE-CAL-06)
  CALENDAR_ABSENCE_MARKED    // to manager: worker marked sick/vacation
}

// ADR-029 (2026-07-23, GD-01): Transactional Outbox enums. OutboxEvent is the
// internal delivery/queue record — distinct from Notification (the user-facing
// inbox, unchanged by this ADR) and never exposed to any client. Domain-event
// naming is past-tense, matching future non-notification event types
// (e.g. CONTRACT_EXPIRED, WORK_REQUEST_CREATED) this enum is expected to grow to.
enum OutboxEventType {
  NOTIFICATION_CREATED
}

// What kind of domain aggregate this event is about. NOTIFICATION today; grows
// additively (ALTER TYPE ... ADD VALUE) as non-notification producers adopt the
// outbox as the future Event Bus producer (ADR-029 §11 / GD-12).
enum OutboxAggregateType {
  NOTIFICATION
}

// Which bounded-context module produced this event — a stable identity, unlike
// producer_service (a class name, kept as a plain String; see OutboxEvent.producer_service).
// Seeded with the four current notification producers (SPEC-NOTIF-001 ASM-NOTIF-01);
// grows additively as new producers are migrated (Epic 7 PR 7.3 migrates these four
// to notificationService.enqueue(); this enum value existing does not itself mean the
// producer has been migrated).
enum OutboxSourceModule {
  WORK_REQUESTS
  WORK_APPLICATIONS
  ATTENDANCE
  QUALITY
  CALENDAR
  DOCUMENTS
}

// Delivery lifecycle. PENDING -> PROCESSING is the Platform Worker's atomic claim
// (SELECT ... FOR UPDATE SKIP LOCKED, ADR-029 §7); PROCESSING -> DELIVERED on success;
// PROCESSING -> FAILED -> (retry) PENDING on a retryable failure; FAILED -> DEAD_LETTER
// once the configurable backoff schedule (default 1m/5m/15m/1h, ADR-029 §6) is exhausted.
// No transitions are performed by this PR — the Platform Worker (PR 7.2) owns them.
enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

// External dispatch transport. Deliberately excludes IN_APP — that is the
// Notification row's own channel (NotificationChannel), not an outbox transport;
// see ADR-029 §1. Only EMAIL/PUSH are implemented (PR 7.4/7.5); WEBHOOK/SMS are
// reserved (ADR-029 §4) and are valid enum values with no handler yet.
enum OutboxTransport {
  EMAIL
  PUSH
  WEBHOOK
  SMS
}

// Epic 7 PR 7.5 (ADR-029): which push provider a registered device token
// belongs to — APNs (iOS) or FCM (Android). Drives PushTransportHandler's
// per-token provider-client routing.
enum PushPlatform {
  IOS
  ANDROID
}

// Epic 7 PR 7.8: which mobile application a device token was registered from.
// APNs requires the `apns-topic` header to equal the *originating app's* bundle
// ID; a token minted by one app and sent with another's topic is rejected
// (DeviceTokenNotForTopic). The two apps have distinct bundle IDs
// (com.hotelcrm.workerapp / com.hotelcrm.checkerapp) and `manager`/`admin` may
// use BOTH, so one user can legitimately hold two IOS tokens needing different
// topics — `platform` alone cannot disambiguate them.
//
// Deliberately stores the *application*, not the bundle ID: the bundle ID is
// deployment configuration (APNS_BUNDLE_ID_WORKER / APNS_BUNDLE_ID_CHECKER), so
// changing one never requires a data migration, and a client can never
// influence an APNs header. FCM ignores this entirely — registration tokens are
// self-identifying, so Android has no equivalent constraint.
enum PushApp {
  WORKER
  CHECKER
}

// Epic 5 PR 5.6 (SPEC-EMP-001 REQ-EMP-002 / RULE-EMP-02, 03, 12): employee
// lifecycle status. No Suspended state; no rating/warning-driven automatic
// transition (invariant, MODULE_SPEC.md "State and Lifecycle").
enum EmploymentStatus {
  INACTIVE
  UNDER_REVIEW
  ACTIVE
  REJECTED
  DEACTIVATED
}

// Epic 5 PR 5.6 (SPEC-EMP-001 REQ-EMP-003 / RULE-EMP-04): fixed confirmed
// skill-tag set; no certifications, no expiring qualifications.
enum SkillTag {
  CLEANER
  PUBLIC_SERVICE
  KITCHEN_DISHWASHER
  WAITER
}

// =============================================================================
// AUTH MODULE
// =============================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password_hash      String
  first_name         String
  last_name          String
  phone              String?   @unique
  profile_photo_url  String?
  role               UserRole  @default(WORKER)
  // ADR-031 M-3 (PR-7): the stored permission snapshot is retired. Permissions
  // are derived request-time from ROLE_PERMISSIONS[role] (D-1); this column
  // ceased being read at PR-3, ceased being written at PR-4, and is dropped
  // here after a full-release soak (relocated to an operational rollout gate,
  // see docs/implementation/ADR-031_PRODUCTION_ROLLOUT_CHECKLIST.md). A
  // pre-drop snapshot is retained for one release per the migration's own
  // down.sql / backup-table note.
  is_active          Boolean   @default(true)
  email_verified_at  DateTime?
  phone_verified_at  DateTime?
  last_login_at      DateTime?
  deleted_at         DateTime? // GDPR soft delete — keep row, null PII via separate job
  // ADR-031 M-1/D-3/D-4 (PR-2, enforced unconditionally as of PR-7): monotonic
  // revocation counter, mirrored into the access token's `token_generation`
  // claim at issuance. Incremented (never reset) by backend-auth on role
  // change / deactivation / soft delete / password reset; a mismatch against
  // the row invalidates an already-issued access token.
  token_generation   Int       @default(0)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  // Relations
  sessions                  Session[]
  hotel_workers             HotelWorker[]
  assignments               WorkerAssignment[]      @relation("assigned_worker")
  assignments_managed       WorkerAssignment[]      @relation("assignment_manager")
  attendance_records        Attendance[]            @relation("attendee")
  attendance_verified       Attendance[]            @relation("attendance_verifier")
  verifications_performed   QualityVerification[]   @relation("verifier")
  ratings_received          Rating[]                @relation("rated_worker")
  ratings_given             Rating[]                @relation("rater")
  overall_rating            WorkerOverallRating?
  notifications             Notification[]
  push_tokens               PushToken[]
  created_work_requests     JobRequest[]            @relation("request_creator")
  audit_logs                AuditLog[]
  password_reset_tokens     PasswordResetToken[]
  managed_hotel_groups      HotelGroup[]            @relation("regional_manager_of_group")
  managed_hotels            Hotel[]                 @relation("hotel_manager")
  calendar_absences         CalendarAbsence[]       @relation("calendar_absence_worker")
  // SPEC-DOCUMENTS-001 (GD-16): documents owned by this worker and uploads
  // performed by this user on behalf of a worker (manager contract-scan, RULE-DOC-04).
  worker_documents            WorkerDocument[]          @relation("documents_worker")
  documents_uploaded          WorkerDocument[]          @relation("documents_uploader")
  // Epic 5 PR 5.6 (SPEC-EMP-001): the employment record's account link
  // (REQ-EMP-001, one record per account) and blocklist-entry authorship.
  employment_record           EmploymentRecord?         @relation("employment_record")
  blocklist_entries_authored  EmployeeBlocklistEntry[]  @relation("blocklist_author")
  // GD-14/OD-GEO-002 (SPEC-GEO-001): backend-geo owns worker-coordinate
  // capture + the 6-month retention sweep (Tier 1, CRR §25).
  geo_checkins                 WorkerGeoCheckin[]        @relation("geo_checkin_worker")
  // ADR-028: manager-entered "rooms completed" daily count, per worker's
  // full-day WorkerAssignment — no room-level task layer implied.
  rooms_completed_as_worker   RoomsCompletedEntry[]     @relation("rooms_completed_worker")
  rooms_completed_entered     RoomsCompletedEntry[]     @relation("rooms_completed_entered_by")
  // Epic 9 PR 9.5 (TREQ-001/MIG-GAP-03): manager calendar-placement direct
  // assignment — the worker placed and the manager who placed them.
  calendar_entries_as_worker  CalendarEntry[]           @relation("calendar_entry_worker")
  calendar_entries_placed     CalendarEntry[]           @relation("calendar_entry_placed_by")

  @@index([role])
  @@index([is_active])
  @@index([deleted_at])
}

model Session {
  id            String   @id @default(cuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_token String   @unique
  device_info   String?
  ip_address    String?
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
}

// HOTFIX-AUTH-002: server-issued, single-use, expiring password-reset token.
// Only its hash is ever persisted; the raw token is the caller's proof of
// email ownership and is never stored.
model PasswordResetToken {
  id         String    @id @default(cuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@index([expires_at])
  // ADR-031 D-5 (PR-6): a partial index on `used_at IS NOT NULL` also exists
  // (migration 20260727000000), supporting the sweep job's used-token
  // cleanup branch. Not expressible in the Prisma schema DSL (no `@@index`
  // WHERE clause) — same accepted drift as WorkerAssignment's partial
  // unique index (migration 20260613120000), which is likewise raw-SQL-only.
}

// =============================================================================
// HOTEL MODULE
// =============================================================================

// HotelGroup: ADR-023 — first-class entity aggregating hotels under one Regional
// Manager with shared billing. Owned by backend-crm. Additive only in this
// migration — no reader/writer consumes it yet (Epic 5 PR 5.1; CRUD lands in
// PR 5.2). One Regional Manager per HotelGroup; a Regional Manager may manage
// several groups (ADR-023 §1), hence the FK lives on HotelGroup, not User.
model HotelGroup {
  id                       String   @id @default(cuid())
  name                     String
  billing_info             String?
  regional_manager_user_id String
  regional_manager         User     @relation("regional_manager_of_group", fields: [regional_manager_user_id], references: [id], onDelete: Restrict)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  // Relations
  hotels Hotel[]
  // Epic 5 PR 5.6 (ADR-023 §4): employment records associated with this group.
  employment_records EmploymentRecord[] @relation("employment_group")

  @@index([regional_manager_user_id])
}

model Hotel {
  id            String   @id @default(cuid())
  name          String
  city          String
  country       String   @default("Germany")
  address       String
  timezone      String   @default("Europe/Berlin")
  contact_email String?
  contact_phone String?
  is_active     Boolean   @default(true)
  // GD-05: per-hotel "pause new jobs" toggle (REQ-CRM-008). Enforced at
  // work-request creation, not a role/scope gate — checked in addition to
  // is_active/deleted_at, not instead of them.
  accepting_jobs Boolean  @default(true)
  // GD-14/OD-GEO-001 (SPEC-GEO-001): the hotel-coordinate source of truth,
  // kept as columns on Hotel (state-hotel, backend-crm-owned), not a
  // separate backend-geo-owned domain. Nullable: most hotels have none set
  // yet; backend-geo's distance-check fails closed (OD-GEO-003) when either
  // is null. Admin-only manual entry (OD-GEO-004) — no geocoding service.
  latitude      Float?
  longitude     Float?
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // ADR-023: nullable until assigned ("after a hotel is created, it is assigned" — CRR §11).
  // ADR-025: nullable — dedicated Hotel Manager assigned after hotel creation (CRR §11).
  // Both additive only in this migration — no reader consumes either field yet (Epic 5 PR 5.1).
  hotel_group_id  String?
  hotel_group     HotelGroup? @relation(fields: [hotel_group_id], references: [id], onDelete: SetNull)
  manager_user_id String?
  manager         User?       @relation("hotel_manager", fields: [manager_user_id], references: [id], onDelete: SetNull)

  // Relations
  hotel_workers    HotelWorker[]
  work_requests    JobRequest[]
  assignments      WorkerAssignment[]
  attendance       Attendance[]
  verifications    QualityVerification[]
  ratings          Rating[]
  notifications    Notification[]
  // Epic 5 PR 5.6 (SPEC-EMP-001 REQ-EMP-005 / RULE-EMP-07): hotel blocklist entries.
  blocklist_entries EmployeeBlocklistEntry[] @relation("hotel_blocklist")
  // ADR-028: manager-entered "rooms completed" daily counts for this hotel.
  rooms_completed_entries RoomsCompletedEntry[]
  // GD-14/OD-GEO-002 (SPEC-GEO-001): worker geofence checks against this
  // hotel's coordinates (backend-geo-owned, read-only from CRM's side).
  geo_checkins            WorkerGeoCheckin[]
  // Epic 9 PR 9.5 (TREQ-001/MIG-GAP-03): manager calendar-placement direct
  // assignments at this hotel.
  calendar_entries        CalendarEntry[]

  @@index([country])
  @@index([is_active])
  @@index([city, country])
  @@index([hotel_group_id])
  @@index([manager_user_id])
}

// HotelWorker: roster — which workers are affiliated with a hotel and at what rate.
// A worker must be ACTIVE on the hotel's roster to be eligible for its WorkRequests.
// SP-2: invited_at records invite issuance; joined_at nullable until INVITED→ACTIVE.
model HotelWorker {
  id          String            @id @default(cuid())
  hotel_id    String
  hotel       Hotel             @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  worker_id   String
  worker      User              @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  position    String            // "cleaner" | "checker" | "housekeeper" | "supervisor"
  status      HotelWorkerStatus @default(INVITED) // SP-1/SP-2: starts INVITED, not ACTIVE
  hourly_rate Decimal?          @db.Decimal(10, 2)
  currency    String            @default("EUR")
  notes       String?
  invited_at  DateTime          @default(now()) // SP-2: set at row creation
  joined_at   DateTime?                         // SP-2: set on INVITED → ACTIVE transition only
  left_at     DateTime?                         // set on → REMOVED transition
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  // A worker appears on a hotel's roster exactly once
  @@unique([hotel_id, worker_id])
  @@index([hotel_id])
  @@index([worker_id])
  @@index([status])
  @@index([position])
}

// =============================================================================
// EMPLOYEE MANAGEMENT MODULE (Epic 5 PR 5.6, SPEC-EMP-001 v0.2.0)
// =============================================================================

// EmploymentRecord: the single authoritative per-employee record (REQ-EMP-001).
// ADR-023 §4: carries hotel_group_id (group-grain FK to backend-crm's
// HotelGroup), nullable until hire-approval, set at Under Review -> Active.
// ADR-025 Decision 3: deliberately hotel-tie-free — no per-hotel FK here.
model EmploymentRecord {
  id                String            @id @default(cuid())
  user_id           String            @unique // account link (REQ-EMP-001: one record per account)
  user              User              @relation("employment_record", fields: [user_id], references: [id], onDelete: Cascade)
  employee_id       String            @unique // human-facing Employee ID
  job_title         String                    // free text, provisional (OD-EMP-13)
  start_date        DateTime
  status            EmploymentStatus  @default(INACTIVE)
  marked_suitable   Boolean           @default(false) // probation milestone flag, not a status
  hotel_group_id    String?                           // ADR-023 §4, group-grain, nullable until hire-approval
  hotel_group       HotelGroup?       @relation("employment_group", fields: [hotel_group_id], references: [id], onDelete: SetNull)
  skills            SkillTag[]                        // fixed set (REQ-EMP-003)
  personal_data     Json?                             // Personalfragebogen non-special data (REQ-EMP-011)
  konfession        String?                           // special-category (RULE-EMP-09) — never on general profile
  disability_status String?                           // special-category (RULE-EMP-09)
  deleted_at        DateTime?                         // soft delete (REQ-EMP-010)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  blocklist_entries EmployeeBlocklistEntry[] @relation("blocklist_of_employee")

  @@index([hotel_group_id])
  @@index([status])
}

// EmployeeBlocklistEntry: hotel-scoped block preventing a specific employee
// from assignment at that hotel, with a mandatory logged reason (REQ-EMP-005 /
// RULE-EMP-07).
model EmployeeBlocklistEntry {
  id                    String   @id @default(cuid())
  hotel_id              String
  hotel                 Hotel    @relation("hotel_blocklist", fields: [hotel_id], references: [id], onDelete: Cascade)
  employment_record_id  String
  employment_record     EmploymentRecord @relation("blocklist_of_employee", fields: [employment_record_id], references: [id], onDelete: Cascade)
  reason                String   // REQUIRED (RULE-EMP-07)
  created_by_id         String
  created_by            User     @relation("blocklist_author", fields: [created_by_id], references: [id], onDelete: Restrict)
  created_at            DateTime @default(now())

  @@unique([hotel_id, employment_record_id])
  @@index([hotel_id])
  @@index([employment_record_id])
}

// =============================================================================
// MARKETPLACE MODULE
// =============================================================================

// SP-9: version column added for optimistic locking against slot-fill race conditions.
// Epic 9 PR 9.4: model renamed WorkRequest -> JobRequest ("re-label schema off
// marketplace" framing, TREQ-013/MIG-GAP-12). @@map("WorkRequest") preserves the
// physical table name so this is a Prisma-level rename only, not a data migration
// (see IMPLEMENTATION_EXECUTION_PLAN.md PR 9.4's repository-reality correction).
model JobRequest {
  id                  String            @id @default(cuid())
  hotel_id            String
  hotel               Hotel             @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  created_by_id       String
  created_by          User              @relation("request_creator", fields: [created_by_id], references: [id], onDelete: Restrict)
  position            String            // required role for this shift
  workers_needed      Int               @default(1)
  workers_confirmed   Int               @default(0)
  version             Int               @default(0) // SP-9: incremented on each status-changing write
  shift_date          DateTime          @db.Date
  shift_start_time    String            // stored as HH:MM; derive full DateTime with hotel timezone
  shift_end_time      String
  hourly_rate         Decimal?          @db.Decimal(10, 2)
  currency            String            @default("EUR")
  description         String?
  requirements        String?           // free-text skill/cert requirements
  status              WorkRequestStatus @default(DRAFT)
  published_at        DateTime?
  expires_at          DateTime?
  filled_at           DateTime?
  cancelled_at        DateTime?
  cancellation_reason String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  // Relations
  assignments  WorkerAssignment[]
  // Epic 9 PR 9.3: back-relation for WorkerAssignment.job_request_id (forward-
  // named ahead of PR 9.4's WorkRequest -> JobRequest rename, now completed).
  // Nullable FK; no creation path populates it until PR 9.9 (broadcast-accept).
  job_request_assignments WorkerAssignment[] @relation("job_request_assignment")
  // Epic 9 PR 9.7 (TREQ-002/TREQ-010, MIG-GAP-04/05): per-skill headcount
  // lines for a broadcast raised via raiseBroadcast(). `position`/
  // `workers_needed`/`workers_confirmed` above are left untouched — they
  // remain the live fields for the pre-existing marketplace publish/apply
  // flow (job-requests/service.ts create()/update(), still reachable until
  // TREQ-011's removal, out of this PR's scope) and for
  // analytics/service.ts's existing aggregate. A broadcast JobRequest (raised
  // by raiseBroadcast(), not create()) carries its skill×headcount breakdown
  // here instead, per CONFIRMED_REQUIREMENTS_REGISTER.md §13's "2 Cleaners +
  // 1 Waiter" example (one broadcast, multiple skill lines) — see
  // architecture review before this PR's implementation.
  skill_slots JobRequestSkillSlot[]

  // workers_confirmed must never exceed workers_needed — CHECK constraint in migration.
  // Slot-fill race: app layer must do UPDATE ... WHERE version = $known AND workers_confirmed < workers_needed.
  @@index([hotel_id])
  @@index([created_by_id])
  @@index([status])
  @@index([shift_date])
  @@index([position])
  @@index([hotel_id, status, shift_date]) // hot path: "open shifts at hotel on date"
  @@map("WorkRequest")
}

// Epic 9 PR 9.7 (TREQ-002/TREQ-003/TREQ-010, MIG-GAP-04/05): one row per
// skill×headcount line on a broadcast JobRequest (raiseBroadcast()), e.g.
// "2 Cleaners + 1 Waiter" is two rows on the same job_request_id. Purely
// additive — no legacy JobRequest row is backfilled into this table, since
// broadcast is new capability, not a repurposed existing field.
//
// `confirmed_count` is included now (default 0, unused by this PR's own
// eligibility-only logic) so PR 9.9's first-accept arbitration has a
// per-skill optimistic-concurrency target to claim against
// (`UPDATE ... WHERE id = $slotId AND confirmed_count < headcount`, the same
// conditional-updateMany shape ADR-057 names as the reused precedent) without
// needing its own schema-only PR before that logic lands.
model JobRequestSkillSlot {
  id             String     @id @default(cuid())
  job_request_id String
  job_request    JobRequest @relation(fields: [job_request_id], references: [id], onDelete: Cascade)
  skill          SkillTag
  headcount      Int
  confirmed_count Int       @default(0)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  // confirmed_count must never exceed headcount — CHECK constraint in migration.
  @@index([job_request_id])
  @@index([skill])
}

// SP-5: @@unique([work_request_id, worker_id]) removed.
//       A worker can have multiple assignment rows for the same request
//       (CANCELLED + new CONFIRMED via reassignment chain). Double-booking for
//       active statuses is prevented by the partial unique index in the migration.
// Epic 9 PR 9.2: application_id (mandatory FK to the now-removed
// WorkApplication) dropped. WorkApplication and ApplicationStatus are
// deleted in this same PR (TREQ-011: no apply endpoint, no WorkApplication
// table). This leaves WorkerAssignment with no create path — the only
// creator was work-applications/service.ts's approve(), deleted alongside
// it. A replacement creation path is out of this PR's scope; PR 9.3 repoints
// this model to a nullable job_request_id, with fresh creation paths landing
// in PR 9.5 (calendar) and PR 9.9 (broadcast accept).
// Epic 9 PR 9.3: job_request_id added (nullable — no creation path writes
// it yet; PR 9.9's broadcast-accept path is the first writer). PR 9.4
// completed the WorkRequest -> JobRequest model rename; job_request_id's
// relation target is the JobRequest model. onDelete: SetNull matches this
// schema's convention for optional FKs (see Hotel.hotel_group,
// User.hotel_group, AuditLog.actor) — an assignment should outlive the job
// request it was created from, not be deleted alongside it.
model WorkerAssignment {
  id                     String           @id @default(cuid())
  // Epic 9 PR 9.5 (TREQ-001/MIG-GAP-03): relaxed from mandatory to nullable.
  // A calendar-placed assignment (placeOnCalendar()) has no backing JobRequest
  // at all (per ADR-056's ratified "no intermediating application or
  // acceptance record required" language) and so cannot populate this column
  // — mirrors PR 9.3's own migration-sequencing reasoning ("avoid a transient
  // assignment-creation-invariant state"), applied here to work_request_id's
  // parallel disposition rather than only to application_id/job_request_id.
  // Every pre-existing row keeps its current non-null value; only the
  // NOT NULL constraint relaxes (additive, reversible, zero data-loss).
  work_request_id        String?
  work_request           JobRequest?      @relation(fields: [work_request_id], references: [id], onDelete: Cascade)
  job_request_id         String?
  job_request            JobRequest?      @relation("job_request_assignment", fields: [job_request_id], references: [id], onDelete: SetNull)
  worker_id              String
  worker                 User             @relation("assigned_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  hotel_id               String
  hotel                  Hotel            @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  assigned_by_id         String
  assigned_by            User             @relation("assignment_manager", fields: [assigned_by_id], references: [id], onDelete: Restrict)
  status                 AssignmentStatus @default(CONFIRMED)
  confirmed_at           DateTime         @default(now())
  started_at             DateTime?
  completed_at           DateTime?
  cancelled_at           DateTime?
  cancellation_reason    String?
  // Self-referential chain for reassignments
  previous_assignment_id String?
  previous_assignment    WorkerAssignment?  @relation("reassignment_chain", fields: [previous_assignment_id], references: [id], onDelete: SetNull)
  reassignments          WorkerAssignment[] @relation("reassignment_chain")
  updated_at             DateTime           @updatedAt

  // Epic 9 PR 9.6 (TREQ-007/TRULE-006, MIG-GAP-08): denormalized calendar
  // day for this assignment, populated identically regardless of creation
  // path (work_request_id-lineage rows backfilled from JobRequest.shift_date;
  // calendar-placed rows backfilled from the sibling CalendarEntry.day;
  // going forward, every creation path writes this directly at create time --
  // see placeOnCalendar()'s follow-up write in assignments/service.ts). Backs
  // the re-keyed WorkerAssignment_active_slot_unique partial index below,
  // which spans every creation path uniformly (unlike the prior
  // work_request_id-scoped index, which could not see a competing
  // calendar-placed or future broadcast-accept assignment on the same day).
  day                    DateTime           @db.Date

  // Relations — each assignment yields at most one attendance record, one QV, one rating,
  // one rooms-completed entry (ADR-028)
  attendance            Attendance?
  quality_verification  QualityVerification?
  rating                Rating?
  rooms_completed_entry RoomsCompletedEntry?
  // Epic 9 PR 9.5 (TREQ-001/MIG-GAP-03): 1:1 with the CalendarEntry created by
  // placeOnCalendar() in the same transaction — present only for
  // calendar-placed assignments (absent for broadcast-accept rows, PR 9.9).
  calendar_entry        CalendarEntry?

  // SP-5: full unique constraint removed. Active-slot double-booking is enforced
  // by the partial unique index in the migration (status IN CONFIRMED, IN_PROGRESS).
  // Epic 9 PR 9.6: re-keyed from (work_request_id, worker_id) to (worker_id,
  // day) -- see WorkerAssignment_active_slot_unique in
  // 20260729030000_add_worker_assignment_day_exclusivity/migration.sql.
  @@index([work_request_id])
  @@index([job_request_id])
  @@index([worker_id])
  @@index([hotel_id])
  @@index([status])
  @@index([confirmed_at])
  @@index([day])
}

// Epic 9 PR 9.5 (TREQ-001/TRULE-001, MIG-GAP-03): per-worker per-day
// assignment-kind record for a manager's DIRECT calendar placement (no
// worker accept/decline step). Owned by backend-assignments (ADR-021's
// "assignment creation... remain owned by Job Dispatch/backend-assignments"),
// NOT backend-calendar — deliberately narrow and non-overlapping with
// Calendar's own state-calendar-absence/CalendarAbsence model (sick/vacation
// marks, ADR-021 Correction v0.3.1): this model records only that a worker
// has an assignment on a given day, not any leave/absence state.
// 1:1 with WorkerAssignment, created in the same transaction by
// placeOnCalendar() (assignments/service.ts) — mirrors RoomsCompletedEntry's
// 1:1-per-assignment shape (schema.prisma:725-744).
model CalendarEntry {
  id             String           @id @default(cuid())
  assignment_id  String           @unique
  assignment     WorkerAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  worker_id      String
  worker         User             @relation("calendar_entry_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  hotel_id       String
  hotel          Hotel            @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  // Date-only (no time component) — the specific day being placed, mirroring
  // CalendarAbsence.day's own shape (schema.prisma:922-923) so both models
  // key "one record per worker per day" identically.
  day            DateTime         @db.Date
  placed_by_id   String
  placed_by      User             @relation("calendar_entry_placed_by", fields: [placed_by_id], references: [id], onDelete: Restrict)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  // TRULE-001/TRULE-006 (daily exclusivity groundwork — full DB-level
  // enforcement is PR 9.6's partial unique index re-keying; this unique
  // constraint only guards against a duplicate CalendarEntry for the same
  // worker/day within this PR's own creation path, not against a competing
  // broadcast-accept assignment on the same day).
  @@unique([worker_id, day])
  @@index([worker_id])
  @@index([hotel_id])
  @@index([day])
}

// =============================================================================
// ATTENDANCE MODULE
// =============================================================================

// SP-6: status defaults to EXPECTED (pre-shift state before worker arrives).
// SP-7: is_verified flag added for efficient manager-dashboard queries.
model Attendance {
  id             String           @id @default(cuid())
  assignment_id  String           @unique // 1-to-1 with WorkerAssignment
  assignment     WorkerAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  worker_id      String
  worker         User             @relation("attendee", fields: [worker_id], references: [id], onDelete: Cascade)
  hotel_id       String
  hotel          Hotel            @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  status         AttendanceStatus @default(EXPECTED) // SP-6
  check_in_at    DateTime?
  check_out_at   DateTime?
  // Denormalised from WorkRequest so payroll/reporting queries need no extra join
  expected_start DateTime?
  expected_end   DateTime?
  minutes_late   Int?
  minutes_worked Int?
  notes          String?
  is_verified    Boolean          @default(false)    // SP-7: set true when manager verifies
  verified_by_id String?
  verified_by    User?            @relation("attendance_verifier", fields: [verified_by_id], references: [id], onDelete: SetNull)
  verified_at    DateTime?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  @@index([worker_id])
  @@index([hotel_id])
  @@index([status])
  @@index([check_in_at])
  @@index([worker_id, check_in_at])    // "worker's shifts in date range"
  @@index([hotel_id, is_verified])     // SP-7: "pending verifications" dashboard
}

// =============================================================================
// QUALITY MODULE
// =============================================================================

model QualityVerification {
  id               String             @id @default(cuid())
  assignment_id    String             @unique // 1-to-1 with WorkerAssignment
  assignment       WorkerAssignment   @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  hotel_id         String
  hotel            Hotel              @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  verified_by_id   String
  verified_by      User               @relation("verifier", fields: [verified_by_id], references: [id], onDelete: Restrict)
  score            Int                // 0–100; CHECK constraint in migration
  status           VerificationStatus @default(PASSED)
  notes            String?
  photo_urls       String[]           // evidence uploaded to object storage
  rework_required  Boolean            @default(false)
  rework_notes     String?
  rework_completed_at DateTime?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  @@index([hotel_id])
  @@index([verified_by_id])
  @@index([status])
  @@index([score])
}

model Rating {
  id            String           @id @default(cuid())
  assignment_id String           @unique // 1-to-1 with WorkerAssignment
  assignment    WorkerAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  hotel_id      String
  hotel         Hotel            @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  worker_id     String
  worker        User             @relation("rated_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  rated_by_id   String
  rated_by      User             @relation("rater", fields: [rated_by_id], references: [id], onDelete: Restrict)
  score         Int              // 0–100; rescaled from 1–5 stars by ADR-026; CHECK constraint in migration
  comment       String?
  // Structured sub-scores; schema: { punctuality: Int, quality: Int, attitude: Int }
  criteria_scores Json?
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  @@index([hotel_id])
  @@index([worker_id])
  @@index([rated_by_id])
  @@index([score])
  @@index([created_at])
}

// Materialised aggregate — updated by DB trigger after each Rating write.
// Avoids expensive AVG() scans on marketplace listing pages.
model WorkerOverallRating {
  id               String    @id @default(cuid())
  worker_id        String    @unique
  worker           User      @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  average_score    Float     // rolling average of Rating.score
  total_ratings    Int       @default(0)
  total_assignments Int      @default(0)
  completion_rate  Float     @default(0.0) // completed / total assignments
  on_time_rate     Float     @default(0.0) // present-on-time / total assignments
  last_worked_at   DateTime?
  updated_at       DateTime  @updatedAt

  @@index([average_score])
  @@index([total_ratings])
}

// ADR-028 (OQ-ANALYTICS-03): "rooms completed per worker" is retained as a basic-
// analytics metric (REQ-ANALYTICS-013), but is NOT a room-level task record — CONFIRMED
// §33 rules out any room-level task layer ("Task"/"Work Request" do NOT need
// separating; full-day employment model). Instead this is a manager-entered daily
// count tied 1-to-1 to the worker's full-day WorkerAssignment, mirroring the
// Attendance/QualityVerification/Rating precedent (denormalised hotel_id/worker_id,
// one row per assignment, entered_by is the acting manager). Deliberately NOT added
// to ReceptionData (PIVOT §9.3: "Manager-entered checkout / long-stay data" only,
// out of scope for this field per its own definition).
model RoomsCompletedEntry {
  id              String           @id @default(cuid())
  assignment_id   String           @unique // 1-to-1 with WorkerAssignment — the worker's full-day assignment
  assignment      WorkerAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  hotel_id        String
  hotel           Hotel            @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  worker_id       String
  worker          User             @relation("rooms_completed_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  entered_by_id   String
  entered_by      User             @relation("rooms_completed_entered_by", fields: [entered_by_id], references: [id], onDelete: Restrict)
  rooms_completed Int              // manager-entered count; CHECK >= 0 in migration
  notes           String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@index([hotel_id])
  @@index([worker_id])
  @@index([entered_by_id])
  @@index([created_at])
}

// =============================================================================
// NOTIFICATIONS MODULE
// =============================================================================

// SP-8: type promoted from String to NotificationType enum.
model Notification {
  id         String              @id @default(cuid())
  user_id    String
  user       User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  hotel_id   String?
  hotel      Hotel?              @relation(fields: [hotel_id], references: [id], onDelete: SetNull)
  type       NotificationType    // SP-8: was String
  channel    NotificationChannel @default(IN_APP)
  title      String
  message    String
  data       Json?               // resource IDs for deep-linking
  is_read    Boolean             @default(false)
  read_at    DateTime?
  sent_at    DateTime?
  expires_at DateTime?
  created_at DateTime            @default(now())

  @@index([user_id])
  @@index([hotel_id])
  @@index([type])
  @@index([created_at])
  @@index([user_id, is_read]) // hot path: unread notification badge count
}

// ADR-029 (2026-07-23, GD-01: Transactional Outbox + Platform Worker). Internal
// delivery/queue record, owned exclusively by backend-notifications — no other
// module writes this table directly; every producer goes through
// notificationService.enqueue() (single-writer discipline, same as Notification
// above). Never exposed to any client. PR 7.1 scope: model + transactional
// enqueue() only — no reads/transitions by a Platform Worker (that is PR 7.2,
// which does not exist yet). Deliberately no foreign keys (ADR-029; an internal
// ledger, not a relation the domain model needs to join through) — additive,
// reversible migration (drop table + 5 enums).
model OutboxEvent {
  id               String              @id @default(cuid())
  event_id         String              @unique @default(uuid()) // per-row idempotency key (ADR-029 §7); provider-side dedup key where the transport supports one
  correlation_id   String              @default(uuid())         // shared across every OutboxEvent row produced by one enqueue() call (one logical notification, N transports)
  event_type       OutboxEventType
  aggregate_type   OutboxAggregateType
  aggregate_id     String                                       // canonical reference (e.g. the sibling Notification.id) — the Platform Worker resolves the aggregate from this column, never from payload
  source_module    OutboxSourceModule
  producer_service String                                       // e.g. "AttendanceService" — a class-name identity, not an enum (churns on refactor; source_module is the stable identity)
  transport        OutboxTransport
  status           OutboxStatus        @default(PENDING)
  payload          Json                                         // domain body ONLY — metadata (event_id, correlation_id, aggregate_*, etc.) is column-sourced, never duplicated into this JSON (ADR-029 §9)
  payload_version  Int                 @default(1)
  scheduled_for    DateTime            @default(now())          // producer intent: when this event should first become eligible; immutable after creation
  next_attempt_at  DateTime            @default(now())          // live retry clock the Platform Worker claims against; initialized to scheduled_for, advanced by backoff on retry (PR 7.2)
  attempts         Int                 @default(0)
  last_error       String?
  processed_at     DateTime?                                    // set on the terminal DELIVERED/DEAD_LETTER transition (PR 7.2); basis for delivery_latency = processed_at - created_at
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  @@index([status, next_attempt_at]) // Platform Worker claim hot path (PR 7.2)
  @@index([correlation_id])
  @@index([aggregate_type, aggregate_id])
  @@index([created_at])
}

// Epic 7 PR 7.5 (ADR-029 §4, Consequences: "a PushToken model for PUSH").
// One row per registered device. `token` is the unique key (not
// user_id+token, deliberately): a device token is device-specific, so
// re-registering the SAME token under a different user reassigns ownership
// (upsert-by-token in NotificationService.registerPushToken) — the correct
// behavior when a different user logs into an already-registered device,
// avoiding delivering pushes to the wrong account. Owned exclusively by
// backend-notifications, same single-writer discipline as Notification/
// OutboxEvent above. Cascade-deletes with its User (mirrors Notification).
model PushToken {
  id         String       @id @default(cuid())
  token      String       @unique
  platform   PushPlatform
  // Epic 7 PR 7.8: the originating app, used to select the correct APNs topic
  // at delivery time (see the PushApp enum). NOT NULL and no default —
  // registration always supplies it, so the transport may assume it exists
  // rather than every future code path handling an impossible null state.
  app        PushApp
  user_id    String
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  @@index([user_id])
}

// =============================================================================
// COMPLIANCE MODULE
// =============================================================================

model AuditLog {
  id            String    @id @default(cuid())
  actor_id      String?
  actor         User?     @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  actor_role    UserRole?
  action        String    // "CREATE" | "READ" | "UPDATE" | "DELETE" | "APPROVE" | "REJECT" | "ASSIGN"
  resource_id   String
  resource_type String    // "WORK_REQUEST" | "APPLICATION" | "ASSIGNMENT" | "ATTENDANCE" | "RATING" etc.
  old_values    Json?     // previous state snapshot for UPDATE/DELETE
  new_values    Json?     // new state snapshot for CREATE/UPDATE
  details       Json?     // additional freeform context
  ip_address    String?
  user_agent    String?
  timestamp     DateTime  @default(now())

  // AuditLog rows are never mutated; no updated_at
  @@index([actor_id])
  @@index([action])
  @@index([resource_type])
  @@index([resource_id])
  @@index([timestamp])
  @@index([resource_type, resource_id]) // "full history of a resource"
}

// =============================================================================
// DOCUMENTS MODULE (SPEC-DOCUMENTS-001 @0.1.4 FROZEN, GD-16 Decided 2026-07-27)
// =============================================================================

// CRR §7 lines 97-98: the only two confirmed document sub-type distinctions.
// No broader category taxonomy is specified by CRR/PDD (OD-DOC-005 category half).
enum DocumentCategory {
  GENERAL      // General onboarding/identity document (all workers)
  WORK_PERMIT  // Residence/work-authorization document (non-EU/EEA/Swiss only, REQ-DOC-003)
}

// state-worker-document (SPEC-DOCUMENTS-001, PDD §9.3 line 389).
// Canonical target-state entity name is WorkerDocument -- not "Document" (PDD §9.3).
// Actors: self-upload (worker) or manager-upload (contract-scan mechanism, RULE-DOC-04).
// All document bytes live in S3 (EU); this table stores metadata only (REQ-DOC-007).
// Retention tier: OD-DOC-001 (open; not yet mapped to CRR §25 tier).
// Special-category applicability: OD-DOC-002 (no confirmed special-category doc type today).
model WorkerDocument {
  id                      String           @id @default(cuid())
  worker_id               String
  worker                  User             @relation("documents_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  // Uploader identity — always derived from the authenticated session (RULE-DOC-08).
  // For worker self-uploads: uploaded_by_id == worker_id.
  // For manager-on-behalf uploads (contract-scan mechanism): uploaded_by_id == manager's user id.
  uploaded_by_id          String
  uploaded_by             User             @relation("documents_uploader", fields: [uploaded_by_id], references: [id])
  category                DocumentCategory
  // Server-generated storage key (RULE-DOC-09): never built from client input;
  // includes a UUIDv4 segment for unpredictability (OD-DOC-017).
  s3_key                  String           @unique
  original_filename       String
  mime_type               String
  file_size_bytes         Int
  // REQ-DOC-001: expiry tracking. Consequence/warning on crossing is OD-DOC-003 (open).
  expires_at              DateTime?        @db.Date
  // REQ-DOC-003: true only for non-EU/EEA/Swiss workers' work-permit documents.
  is_work_permit          Boolean          @default(false)
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  // OD-DOC-019 (FIND-PERF-001): compound index required at schema-creation time.
  @@index([worker_id, category])
  @@index([worker_id])
}

// =============================================================================
// CALENDAR MODULE (SPEC-CALENDAR-001, narrow ADR-021 slice)
// =============================================================================

// state-calendar-absence (SPEC-CALENDAR-001 REQ-CAL-T08): Calendar-owned,
// distinct from Job Dispatch's CalendarEntry/WorkerAssignment (ADR-021).
// Stores only a plain sick/vacation flag -- no health data (CRR §27 §353),
// no leave-balance accounting (non-goal, REQ-CAL-T07).
model CalendarAbsence {
  id         String              @id @default(cuid())
  worker_id  String
  worker     User                @relation("calendar_absence_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  // Date-only (no time component); the specific day being marked, not a range.
  day        DateTime            @db.Date
  kind       CalendarAbsenceKind
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt

  // RULE-CAL-03: one mark per worker per day.
  @@unique([worker_id, day])
  @@index([worker_id])
  @@index([day])
}

// =============================================================================
// GEO MODULE (SPEC-GEO-001 @0.1.2 FROZEN, GD-14 Decided 2026-07-27)
// =============================================================================

// state-worker-geo-checkin (SPEC-GEO-001 TREQ-GEO-004/005, RULE-GEO-004):
// backend-geo-owned (OD-GEO-002) -- the ONLY module that writes/reads this
// model. Distinct from Hotel.latitude/longitude (backend-crm-owned,
// OD-GEO-001) and from Attendance's own CHECK_IN/UPDATE_ATTENDANCE record --
// this row is the captured device coordinate + computed distance for one
// geofence check, not an attendance-state transition (backend-attendance
// remains sole owner of that, unmodified by this module).
//
// RULE-GEO-003/OD-GEO-005: raw latitude/longitude are stored here but MUST
// NEVER be returned by any admin/manager-facing API -- only distance_meters
// and inside_radius are exposed cross-role. Enforced in service.ts's DTO
// mapping, not by the schema itself.
model WorkerGeoCheckin {
  id              String   @id @default(cuid())
  worker_id       String
  worker          User     @relation("geo_checkin_worker", fields: [worker_id], references: [id], onDelete: Cascade)
  hotel_id        String
  hotel           Hotel    @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  // Raw device coordinates (RULE-GEO-002: sampled only at this single check,
  // never continuous/background). Personal location data -- GDPR Tier 1.
  latitude        Float
  longitude       Float
  // Computed at write time (RULE-GEO-001): distance_meters is exposed to
  // admin/manager; latitude/longitude above are not (OD-GEO-005).
  distance_meters Float
  inside_radius   Boolean
  checked_at      DateTime @default(now())

  // RULE-GEO-004/TREQ-GEO-005: 6-month hard-delete retention sweep scans on
  // checked_at, not created_at, to match "6 months after capture" precisely
  // (the two are identical at write time, but checked_at is the
  // spec-cited field).
  @@index([worker_id])
  @@index([hotel_id])
  @@index([checked_at])
}

rules_version = '2';

// Push-token store (backend/src/modules/notifications/push-token-store.ts).
//
// Every document under this project is written and read exclusively by the
// backend's Firebase Admin SDK credential, which bypasses these rules
// entirely. No client — neither mobile app, nor a browser — authenticates to
// Firebase in this system: the apps sign in against the backend's own JWT
// auth and register their device token through the authenticated
// `POST /notifications/push-tokens` endpoint.
//
// So this file denies everything, deliberately. A permissive rule here would
// let any holder of the (publicly embeddable) Firebase web API key write to
// `users/{userId}/pushTokens/{id}` for an arbitrary userId, which is a
// notification-hijacking primitive: the attacker's device would receive
// another user's push notifications, including their contents.
//
// If a client ever does need direct Firestore access, that requires a real
// per-user rule keyed on a Firebase identity — not a relaxation of this one.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
